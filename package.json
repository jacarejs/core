{
  "name": "jacare",
  "version": "0.0.0",
  "private": true,
  "description": "Next-generation front-end framework",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jacarejs/core.git"
  },
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "yarn workspace @jacare/core build && yarn workspace @jacare/compiler build && yarn workspace @jacare/vite-plugin build && yarn workspace @jacare/meta build && yarn workspace @jacare/cli build && yarn workspace @jacare/devtools build",
    "pretest": "yarn build",
    "pretypecheck": "yarn workspace @jacare/core build && yarn workspace @jacare/compiler build && yarn workspace @jacare/vite-plugin build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "yarn workspace @jacare/core typecheck && yarn workspace @jacare/compiler typecheck && yarn workspace @jacare/vite-plugin typecheck && yarn workspace @jacare/meta typecheck && yarn workspace @jacare/cli typecheck && yarn workspace @jacare/devtools typecheck",
    "example:dev": "yarn workspace jacare-todo dev",
    "example:build": "yarn workspace jacare-todo build",
    "showcase:dev": "yarn workspace jacare-showcase dev",
    "showcase:build": "yarn workspace jacare-showcase build",
    "bmi:dev": "yarn workspace jacare-bmi dev",
    "bmi:build": "yarn workspace jacare-bmi build",
    "lab:dev": "yarn workspace jacare-lab dev",
    "lab:build": "yarn workspace jacare-lab build",
    "studio:dev": "yarn workspace jacare-studio dev",
    "studio:build": "yarn workspace jacare-studio build",
    "island:dev": "yarn workspace jacare-island dev",
    "island:build": "yarn workspace jacare-island build",
    "island-react:dev": "yarn workspace jacare-island-react dev",
    "island-react:build": "yarn workspace jacare-island-react build",
    "island-vue:dev": "yarn workspace jacare-island-vue dev",
    "island-vue:build": "yarn workspace jacare-island-vue build",
    "island-angular:dev": "yarn workspace jacare-island-angular dev",
    "island-angular:build": "yarn workspace jacare-island-angular build",
    "bench": "yarn build && node benchmarks/run.mjs",
    "changelog": "node scripts/changelog.mjs preview",
    "changelog:bootstrap": "node scripts/changelog.mjs bootstrap",
    "changelog:check": "node scripts/changelog.mjs check",
    "jacare": "node packages/cli/dist/index.js",
    "chrome-devtools:pack": "node scripts/pack-chrome-devtools.mjs",
    "pages:prepare": "node scripts/prepare-pages-site.mjs"
  },
  "devDependencies": {
    "@jacare/cli": "0.1.15",
    "@types/node": "^22.10.0",
    "happy-dom": "^15.11.7",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
