{
  "manifest_version": 3,
  "name": "Jacaré Devtools",
  "version": "0.1.0",
  "description": "Inspect live state, routes, .jcr screens, Mesh, and Scope in Jacaré apps from Chrome DevTools.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "devtools_page": "devtools.html",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["scripting"],
  "web_accessible_resources": [
    {
      "resources": ["page-hook.js"],
      "matches": ["http://localhost/*", "http://127.0.0.1/*", "https://*/*", "http://*/*"]
    }
  ],
  "host_permissions": ["http://localhost/*", "http://127.0.0.1/*", "https://*/*", "http://*/*"]
}
