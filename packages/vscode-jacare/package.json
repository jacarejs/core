{
  "name": "jacare",
  "displayName": "Jacaré",
  "description": "Syntax highlighting, Mesh hover, compile diagnostics, snippets, and icons for Jacaré .jcr files",
  "version": "0.0.23",
  "publisher": "heberalmeida",
  "author": {
    "name": "Heber Almeida"
  },
  "license": "MIT",
  "galleryBanner": {
    "color": "#0b3d2e",
    "theme": "dark"
  },
  "icon": "icons/jacare-256.png",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jacarejs/core.git",
    "directory": "packages/vscode-jacare"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Themes"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "jacare",
        "aliases": [
          "Jacaré",
          "jacare",
          "jcr"
        ],
        "extensions": [
          ".jcr"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/jacare-128.png",
          "dark": "./icons/jacare-128.png"
        }
      },
      {
        "id": "typescript",
        "extensions": [
          ".jcr.ts"
        ]
      }
    ],
    "grammars": [
      {
        "language": "jacare",
        "scopeName": "source.jacare",
        "path": "./syntaxes/jacare.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.block.css.jacare": "css",
          "meta.embedded.block.scss.jacare": "scss",
          "meta.embedded.block.less.jacare": "less",
          "meta.embedded.block.html.jacare": "html",
          "meta.embedded.block.typescript.jacare": "typescript",
          "meta.embedded.expression.jacare": "javascript",
          "text.html.jacare": "html"
        }
      }
    ],
    "themes": [
      {
        "label": "Jacaré scopes (dark)",
        "uiTheme": "vs-dark",
        "path": "./themes/jacare-scopes-dark.json"
      },
      {
        "label": "Jacaré scopes (light)",
        "uiTheme": "vs",
        "path": "./themes/jacare-scopes-light.json"
      }
    ],
    "iconThemes": [
      {
        "id": "jacare-icons",
        "label": "Jacaré Icons",
        "path": "./icons/jacare-icon-theme.json"
      }
    ],
    "snippets": [
      {
        "language": "jacare",
        "path": "./snippets/jacare.json"
      },
      {
        "language": "typescript",
        "path": "./snippets/jacare-ts.json"
      },
      {
        "language": "javascript",
        "path": "./snippets/jacare-js.json"
      },
      {
        "language": "typescript",
        "path": "./snippets/jacare-js.json"
      }
    ],
    "configurationDefaults": {
      "files.associations": {
        "*.jcr.ts": "typescript"
      }
    },
    "commands": [
      {
        "command": "jacare.openLabLesson",
        "title": "Jacaré: Open Lab Lesson for Symbol"
      }
    ]
  },
  "scripts": {
    "prebuild": "yarn --cwd ../compiler build",
    "build": "node scripts/build.mjs",
    "package": "yarn build && vsce package --no-yarn",
    "publish": "yarn build && vsce publish --no-yarn",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "esbuild": "^0.25.0"
  },
  "devDependencies": {
    "@jacare/compiler": "0.1.15",
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.2.1",
    "typescript": "^5.7.2"
  }
}
