{
  "name": "jacare",
  "displayName": "Jacaré",
  "description": "Syntax highlighting, snippets, and icons for Jacaré .jcr files",
  "version": "0.0.17",
  "publisher": "heberalmeida",
  "author": {
    "name": "Heber Almeida"
  },
  "license": "MIT",
  "galleryBanner": {
    "color": "#0b3d2e",
    "theme": "dark"
  },
  "icon": "icons/jacare-256.png",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jacarejs/core.git",
    "directory": "packages/vscode-jacare"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Themes"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "jacare",
        "aliases": [
          "Jacaré",
          "jacare",
          "jcr"
        ],
        "extensions": [
          ".jcr"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/jacare-128.png",
          "dark": "./icons/jacare-128.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "jacare",
        "scopeName": "source.jacare",
        "path": "./syntaxes/jacare.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.block.css.jacare": "css",
          "meta.embedded.block.scss.jacare": "scss",
          "meta.embedded.block.less.jacare": "less",
          "meta.embedded.block.html.jacare": "html",
          "meta.embedded.expression.jacare": "javascript",
          "text.html.jacare": "html"
        }
      }
    ],
    "iconThemes": [
      {
        "id": "jacare-icons",
        "label": "Jacaré Icons",
        "path": "./icons/jacare-icon-theme.json"
      }
    ],
    "snippets": [
      {
        "language": "jacare",
        "path": "./snippets/jacare.json"
      }
    ]
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "package": "yarn build && vsce package --no-dependencies",
    "publish": "yarn build && vsce publish --no-dependencies",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.2.1",
    "typescript": "^5.7.2"
  }
}
