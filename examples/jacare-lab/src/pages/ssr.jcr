import { pulse, derive } from '@jacare/core'
import { t, translate } from '../i18n.js'
import Tip from '../components/Tip.jcr'
import Demo from '../components/Demo.jcr'
import {
  renderCode,
  resumeMentalModelCode,
  resumeCode,
  renderToStringCode,
  renderToStreamCode,
} from '../snippets/ssr.js'

const mirrorCount = pulse(0)

function bumpMirror() {
  mirrorCount.update((n) => n + 1)
}

const hydrated = pulse(false)
const postHydrateClicks = pulse(0)
const hydrationStatus = derive(() =>
  translate(hydrated() ? 'ssrPage.hydration.done' : 'ssrPage.hydration.pending'),
)

function simulateResume() {
  hydrated.set(true)
}

function onHydratedClick() {
  if (!hydrated()) return
  postHydrateClicks.update((n) => n + 1)
}

export <view>
  <section class="page">
    <header class="page-hero">
      <p class="page-kicker">${t('ssrPage.kicker')}</p>
      <h1 class="page-title">${t('ssrPage.title')}</h1>
      <p class="page-lead">${t('ssrPage.lead')}</p>
    </header>

    <Tip :text=${translate('ssrPage.tip')} />

    <div class="lesson-grid">
      <Demo :title=${translate('ssrPage.demo.render.title')} :lead=${translate('ssrPage.demo.render.lead')} :code=${renderCode}>
        <div class="stack">
          <span class="metric">${mirrorCount}</span>
          <button type="button" class="btn" on-click=${bumpMirror}>${t('ssrPage.demo.render.bump')}</button>
          <p class="muted">${t('ssrPage.demo.render.note')}</p>
        </div>
      </Demo>

      <Demo :title=${translate('ssrPage.demo.mental.title')} :lead=${translate('ssrPage.demo.mental.lead')} :code=${resumeMentalModelCode}>
        <div class="stack">
          <p class="muted">${hydrationStatus}</p>
          <div class="row">
            <button type="button" class="btn" disabled=${!hydrated()} on-click=${onHydratedClick}>
              ${t('ssrPage.demo.mental.click')}
            </button>
            <button type="button" class="btn btn-outline" on-click=${simulateResume}>${t('ssrPage.demo.mental.simulate')}</button>
          </div>
          <p class="muted">${t('ssrPage.demo.mental.clicks')} ${postHydrateClicks}</p>
        </div>
      </Demo>

      <Demo :title=${translate('ssrPage.demo.resume.title')} :lead=${translate('ssrPage.demo.resume.lead')} :code=${resumeCode}>
        <p class="muted">${t('ssrPage.demo.resume.note')}</p>
      </Demo>

      <Demo :title=${translate('ssrPage.demo.string.title')} :lead=${translate('ssrPage.demo.string.lead')} :code=${renderToStringCode}>
        <p class="muted">${t('ssrPage.demo.string.note')}</p>
      </Demo>

      <Demo :title=${translate('ssrPage.demo.stream.title')} :lead=${translate('ssrPage.demo.stream.lead')} :code=${renderToStreamCode}>
        <p class="muted">${t('ssrPage.demo.stream.note')}</p>
      </Demo>
    </div>
  </section>
</view>
