import { pulse, derive } from '@jacare/core'
import { t, translate } from '../i18n.js'
import Tip from '../components/Tip.jcr'
import Demo from '../components/Demo.jcr'
import Badge from '../components/Badge.jcr'
import IconButton from '../components/IconButton.jcr'
import { cookbookCode, searchCode } from '../snippets/cookbook.js'

const draft = pulse('')
const nextId = pulse(3)
const tasks = pulse([
  { id: '1', key: 'readDocs', done: true },
  { id: '2', key: 'buildLesson', done: false },
])

const visibleTasks = derive(() =>
  tasks().map((task) => ({
    ...task,
    label: task.key ? translate(`cookbookPage.task.${task.key}`) : task.label,
  })),
)
const remaining = derive(() => tasks().filter((task) => !task.done).length)
const remainingLabel = derive(() =>
  translate(remaining() === 1 ? 'cookbookPage.remainingOne' : 'cookbookPage.remainingMany', {
    count: remaining(),
  }),
)
const isEmpty = derive(() => tasks().length === 0)

function addTask() {
  const label = draft().trim()
  if (!label) return
  const id = String(nextId())
  nextId.update((n) => n + 1)
  tasks.update((list) => [...list, { id, label, done: false }])
  draft.set('')
}

function toggleTask(id) {
  tasks.update((list) => list.map((task) => (task.id === id ? { ...task, done: !task.done } : task)))
}

function removeTask(id) {
  tasks.update((list) => list.filter((task) => task.id !== id))
}

function onDraftKeydown(event) {
  if (event.key === 'Enter') addTask()
}

const contactQuery = pulse('')
const contactBook = [
  { id: 'a', name: 'Ada Lovelace', roleKey: 'engineer' },
  { id: 'b', name: 'Grace Hopper', roleKey: 'engineer' },
  { id: 'c', name: 'Alan Turing', roleKey: 'mathematician' },
  { id: 'd', name: 'Katherine Johnson', roleKey: 'mathematician' },
]

const contacts = derive(() =>
  contactBook.map((person) => ({
    ...person,
    role: translate(`cookbookPage.role.${person.roleKey}`),
  })),
)

const matches = derive(() => {
  const q = contactQuery().trim().toLowerCase()
  if (!q) return contacts()
  return contacts().filter(
    (person) => person.name.toLowerCase().includes(q) || person.role.toLowerCase().includes(q),
  )
})
const matchLabel = derive(() =>
  translate(matches().length === 1 ? 'cookbookPage.matchOne' : 'cookbookPage.matchMany', {
    count: matches().length,
  }),
)

export <view>
  <section class="page">
    <header class="page-hero">
      <p class="page-kicker">${t('cookbookPage.kicker')}</p>
      <h1 class="page-title">${t('cookbookPage.title')}</h1>
      <p class="page-lead">${t('cookbookPage.lead')}</p>
    </header>

    <Tip :text=${translate('cookbookPage.tip')} />

    <div class="lesson-grid">
      <Demo :title=${translate('cookbookPage.demo.tasks.title')} :lead=${translate('cookbookPage.demo.tasks.lead')} :code=${cookbookCode}>
        <div class="stack">
          <div class="row">
            <Badge :text=${remainingLabel} />
            <span class="muted">${tasks().length} ${t('cookbookPage.total')}</span>
          </div>

          <div class="row">
            <input class="input" bind-value=${draft} placeholder=${translate('cookbookPage.draftPlaceholder')} on-keydown=${onDraftKeydown} />
            <button type="button" class="btn" on-click=${addTask}>${t('cookbookPage.add')}</button>
          </div>

          #if isEmpty()
            <p class="muted">${t('cookbookPage.emptyTasks')}</p>
          #else
            <ul class="list">
              #for visibleTasks() as task (task.id)
                <li class="list-item" class-done=${task.done}>
                  <span class="item-label" on-click=${() => toggleTask(task.id)}>${task.label}</span>
                  <IconButton :label=${translate('cookbookPage.delete')} on-press=${() => removeTask(task.id)} />
                </li>
              #end
            </ul>
          #end
        </div>
      </Demo>

      <Demo :title=${translate('cookbookPage.demo.search.title')} :lead=${translate('cookbookPage.demo.search.lead')} :code=${searchCode}>
        <div class="stack">
          <div class="row">
            <input class="input" bind-value=${contactQuery} placeholder=${translate('cookbookPage.searchPlaceholder')} />
            <Badge :text=${matchLabel} />
          </div>
          #if matches().length === 0
            <p class="muted">${t('cookbookPage.emptySearch')}</p>
          #else
            <ul class="list">
              #for matches() as person (person.id)
                <li class="list-item">
                  <span class="item-label">${person.name}</span>
                  <span class="muted">${person.role}</span>
                </li>
              #end
            </ul>
          #end
        </div>
      </Demo>
    </div>
  </section>
</view>
