import { pulse, derive } from '@jacare/core'
import Tip from '../components/Tip.jcr'
import Demo from '../components/Demo.jcr'
import Badge from '../components/Badge.jcr'
import Card from '../components/Card.jcr'
import IconButton from '../components/IconButton.jcr'
import Counter from '../components/Counter.jcr'
import ModelField from '../components/ModelField.jcr'
import { t, translate } from '../i18n.js'
import {
  cardCode,
  iconButtonCode,
  counterCode,
  modelFieldCode,
  nestedCode,
  optionalLeadCode,
  debugPropsCode,
} from '../snippets/components.js'

const moods = ['curious', 'focused', 'shipping']
const mood = pulse('curious')

function cycleMood() {
  const index = moods.indexOf(mood())
  mood.set(moods[(index + 1) % moods.length])
}

const removed = pulse(0)

function onRemovePress() {
  removed.update((n) => n + 1)
}

const removedLabel = derive(() => translate('components.demo.iconButton.removed', { n: removed() }))

const score = pulse(0)

function onScoreInc() {
  score.update((n) => n + 1)
}

const playerName = pulse('Jacaré')
const playerGreeting = derive(() => translate('components.demo.model.hello', { name: playerName() }))

const teamScore = pulse(0)

function onTeamScoreInc() {
  teamScore.update((n) => n + 1)
}

const noteText = pulse('')

export <view>
  <section class="page">
    <header class="page-hero">
      <p class="page-kicker">${t('components.kicker')}</p>
      <h1 class="page-title">${t('components.title')}</h1>
      <p class="page-lead">${t('components.lead')}</p>
    </header>

    <Tip :text=${t('components.tip')} />

    <div class="lesson-grid">
      <Demo :title=${t('components.demo.card.title')} :lead=${t('components.demo.card.lead')} :code=${cardCode}>
        <Card :title=${t('components.demo.card.cardTitle')} :subtitle=${t('components.demo.card.cardSubtitle')}>
          <p class="muted">${t('components.demo.card.projected')}</p>
          <Badge :text=${mood} />
          <div slot="actions">
            <button type="button" class="btn btn-outline" on-click=${cycleMood}>${t('components.demo.card.cycleMood')}</button>
          </div>
        </Card>
      </Demo>

      <Demo :title=${t('components.demo.iconButton.title')} :lead=${t('components.demo.iconButton.lead')} :code=${iconButtonCode}>
        <div class="stack">
          <IconButton :label=${t('components.demo.iconButton.removeLabel')} on-press=${onRemovePress} />
          <p class="muted">${removedLabel}</p>
        </div>
      </Demo>

      <Demo :title=${t('components.demo.counter.title')} :lead=${t('components.demo.counter.lead')} :code=${counterCode}>
        <Counter :label=${t('components.demo.counter.scoreLabel')} :count=${score} on-inc=${onScoreInc} />
      </Demo>

      <Demo :title=${t('components.demo.model.title')} :lead=${t('components.demo.model.lead')} :code=${modelFieldCode}>
        <div class="stack">
          <ModelField :label=${t('components.demo.model.playerLabel')} bind-value=${playerName} />
          <p class="muted">${playerGreeting}</p>
        </div>
      </Demo>

      <Demo :title=${t('components.demo.nested.title')} :lead=${t('components.demo.nested.lead')} :code=${nestedCode}>
        <Card :title=${t('components.demo.nested.cardTitle')} :subtitle=${t('components.demo.nested.cardSubtitle')}>
          <Counter :label=${t('components.demo.nested.teamScoreLabel')} :count=${teamScore} on-inc=${onTeamScoreInc} />
        </Card>
      </Demo>

      <Demo :title=${t('components.demo.optional.title')} :lead=${t('components.demo.optional.lead')} :code=${optionalLeadCode}>
        <div class="stack">
          <Card :title=${t('components.demo.optional.cardTitle')}>
            <p class="muted">${t('components.demo.optional.note')}</p>
            <input class="input" bind-value=${noteText} placeholder=${t('components.demo.optional.placeholder')} />
          </Card>
        </div>
      </Demo>

      <Demo :title=${t('components.demo.debug.title')} :lead=${t('components.demo.debug.lead')} :code=${debugPropsCode}>
        <div class="stack">
          <div class="row">
            <Counter :label=${t('components.demo.counter.scoreLabel')} :count=${score} on-inc=${onScoreInc} />
            <button type="button" class="btn btn-outline" on-click=${cycleMood}>${t('components.demo.card.cycleMood')}</button>
          </div>
          <debug copy label="props">${{ score, mood, removed, playerName }}</debug>
        </div>
      </Demo>
    </div>
  </section>
</view>
