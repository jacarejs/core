import Tip from '../components/Tip.jcr'
import Demo from '../components/Demo.jcr'
import BagTreeParent from '../components/BagTreeParent.jcr'
import CartLinkBadge from '../components/CartLinkBadge.jcr'
import Mesh30Catalog from '../components/Mesh30Catalog.jcr'
import Mesh30Chrome from '../components/Mesh30Chrome.jcr'
import { demoCart } from '../bags/cart.js'
import '../bags/mesh30.js'
import { lazyBag, lazyFactoryRuns } from '../bags/lazy.js'
import { appHref } from '../app-base.js'
import { t, translate } from '../i18n.js'
import {
  defineBagCode,
  useBagCode,
  snapHydrateCode,
  deepTreeCode,
  contractLinksCode,
  lazyPublishCode,
  addressSugarCode,
  meshArchDiagram,
  mesh30LessonCode,
} from '../snippets/bag.js'

const PRODUCTS = [
  { id: 'tea', price: 9 },
  { id: 'cap', price: 22 },
  { id: 'zine', price: 12 },
]

export <view>
  <section class="page">
    <header class="page-hero">
      <p class="page-kicker">${t('bag.kicker')}</p>
      <h1 class="page-title">${t('bag.title')}</h1>
      <p class="page-lead">${t('bag.lead')}</p>
    </header>

    <Demo
      :title=${t('bag.mesh30.title')}
      :lead=${t('bag.mesh30.lead')}
      :code=${mesh30LessonCode}
    >
      <div class="mesh30">
        <ol class="mesh30-steps">
          <li><strong>createBag</strong> — ${t('bag.mesh30.step1')}</li>
          <li><strong>${t('bag.mesh30.screenA')}</strong> — <code>import</code> + <code>ripple</code> ${t('bag.mesh30.step2')} <code>add</code></li>
          <li><strong>${t('bag.mesh30.screenB')}</strong> — <code>${'@lab-mesh30/count'}</code> (${t('bag.mesh30.step3')})</li>
        </ol>

        <div class="mesh30-screens" :aria-label=${translate('bag.mesh30.screensAria')}>
          <Mesh30Catalog />
          <Mesh30Chrome />
        </div>

        <p class="mesh30-foot">
          <a class="btn" jacare-go="/bag/checkout" href=${appHref('/bag/checkout')}>
            ${t('bag.mesh30.openCheckout')}
          </a>
          <span class="muted">${t('bag.mesh30.sameBag')} <code>lab-mesh30</code> — ${t('bag.mesh30.bookmarkable')}</span>
        </p>
      </div>
    </Demo>

    <Tip :text=${t('bag.tip')} />

    <div class="arch-panel">
      <div class="arch-panel__intro">
        <h2 class="arch-panel__title">${t('bag.arch.title')}</h2>
        <p class="arch-panel__lead">${t('bag.arch.lead')}</p>
      </div>

      <pre class="arch-diagram" :aria-label=${translate('bag.arch.diagramAria')}>${meshArchDiagram}</pre>

      <div class="arch-grid">
        <article class="ref-card">
          <h3>${t('bag.arch.idea.title')}</h3>
          <p class="muted">${t('bag.arch.idea.body')}</p>
          <ul class="arch-list">
            <li>${t('bag.arch.idea.item1')}</li>
            <li>${t('bag.arch.idea.item2')}</li>
            <li>${t('bag.arch.idea.item3')}</li>
          </ul>
        </article>

        <article class="ref-card">
          <h3>${t('bag.arch.how.title')}</h3>
          <p class="muted">${t('bag.arch.how.body')}</p>
          <ul class="arch-list">
            <li>${t('bag.arch.how.item1')}</li>
            <li>${t('bag.arch.how.item2')}</li>
            <li>${t('bag.arch.how.item3')}</li>
          </ul>
        </article>

        <article class="ref-card">
          <h3>${t('bag.arch.light.title')}</h3>
          <p class="muted">${t('bag.arch.light.body')}</p>
          <ul class="arch-list">
            <li>${t('bag.arch.light.item1')}</li>
            <li>${t('bag.arch.light.item2')}</li>
            <li>${t('bag.arch.light.item3')}</li>
            <li>${t('bag.arch.light.item4')}</li>
          </ul>
        </article>

        <article class="ref-card">
          <h3>${t('bag.arch.shipped.title')}</h3>
          <p class="muted">${t('bag.arch.shipped.body')}</p>
          <ul class="arch-list">
            <li>${t('bag.arch.shipped.item1')}</li>
            <li>${t('bag.arch.shipped.item2')}</li>
            <li>${t('bag.arch.shipped.item3')}</li>
            <li>${t('bag.arch.shipped.item4')}</li>
            <li>${t('bag.arch.shipped.item5')}</li>
            <li>${t('bag.arch.shipped.item6')}</li>
          </ul>
        </article>
      </div>
    </div>

    <div class="lesson-grid">
      <Demo :title=${t('bag.demo.define.title')} :lead=${t('bag.demo.define.lead')} :code=${defineBagCode}>
        <div class="stack">
          <div class="row">
            #for PRODUCTS as product (product.id)
              <button type="button" class="btn btn-outline" on-click=${() => demoCart.add(product)}>
                ${t('bag.products.' + product.id)}
              </button>
            #end
          </div>
          <p class="metric">${demoCart.count} · ${demoCart.money}</p>
          <div class="row">
            <button type="button" class="btn btn-ghost" on-click=${demoCart.clear}>${t('bag.demo.define.clear')}</button>
          </div>
        </div>
      </Demo>

      <Demo :title=${t('bag.demo.use.title')} :lead=${t('bag.demo.use.lead')} :code=${useBagCode}>
        <div class="stack">
          #if demoCart.count() === 0
            <p class="muted">${t('bag.demo.use.empty')}</p>
          #else
            <ul class="list">
              #for demoCart.items() as line (line.id)
                <li class="list-item">
                  <span class="item-label">${t('bag.products.' + line.id)} × ${line.qty}</span>
                  <button type="button" class="btn btn-outline" on-click=${() => demoCart.remove(line.id)}>
                    ${t('bag.demo.use.remove')}
                  </button>
                </li>
              #end
            </ul>
          #end
        </div>
      </Demo>

      <Demo
        :title=${t('bag.demo.links.title')}
        :lead=${t('bag.demo.links.lead')}
        :code=${contractLinksCode}
      >
        <CartLinkBadge />
      </Demo>

      <Demo
        :title=${t('bag.demo.lazy.title')}
        :lead=${t('bag.demo.lazy.lead')}
        :code=${lazyPublishCode}
      >
        <div class="stack">
          <p class="metric">${t('bag.demo.lazy.runs')} · ${lazyFactoryRuns}</p>
          <div class="row">
            <button
              type="button"
              class="btn"
              on-click=${() => {
                void lazyBag.label
                void lazyBag.ticks
              }}
            >
              ${t('bag.demo.lazy.touch')}
            </button>
            <button type="button" class="btn btn-outline" on-click=${() => lazyBag.bump()}>
              ${t('bag.demo.lazy.bump')}
            </button>
          </div>
          <p class="muted">${t('bag.demo.lazy.note')}</p>
        </div>
      </Demo>

      <Demo
        :title=${t('bag.demo.address.title')}
        :lead=${t('bag.demo.address.lead')}
        :code=${addressSugarCode}
      >
        <div class="stack">
          <p class="metric">@lab-cart · ${@lab-cart/count} · ${@lab-cart/money}</p>
          <button type="button" class="btn btn-ghost" on-click=${@lab-cart/clear}>
            ${t('bag.demo.address.clear')}
          </button>
        </div>
      </Demo>

      <Demo
        :title=${t('bag.demo.tree.title')}
        :lead=${t('bag.demo.tree.lead')}
        :code=${deepTreeCode}
      >
        <BagTreeParent />
      </Demo>

      <Demo :title=${t('bag.demo.snap.title')} :lead=${t('bag.demo.snap.lead')} :code=${snapHydrateCode}>
        <div class="row">
          <button
            type="button"
            class="btn"
            on-click=${() => {
              const snap = demoCart.snap()
              sessionStorage.setItem('jacare-lab:cart', JSON.stringify(snap))
            }}
          >
            ${t('bag.demo.snap.snap')}
          </button>
          <button
            type="button"
            class="btn btn-outline"
            on-click=${() => {
              const raw = sessionStorage.getItem('jacare-lab:cart')
              if (!raw) return
              demoCart.hydrate(JSON.parse(raw))
            }}
          >
            ${t('bag.demo.snap.hydrate')}
          </button>
          <button type="button" class="btn btn-ghost" on-click=${() => demoCart.reset()}>
            ${t('bag.demo.snap.reset')}
          </button>
        </div>
      </Demo>
    </div>
  </section>
</view>
