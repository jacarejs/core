import { pulse } from '@jacare/core'
import Tip from '../components/Tip.jcr'
import Demo from '../components/Demo.jcr'
import ScopedA from '../components/ScopedA.jcr'
import ScopedB from '../components/ScopedB.jcr'
import { t } from '../i18n.js'
import {
  scopedCode,
  globalCode,
  spotlightCode,
  hueChipCode,
  styleIfCode,
  styleCaseCode,
  styleForCode,
} from '../snippets/css.js'

const outlineOn = pulse(true)

function toggleOutline() {
  outlineOn.update((on) => !on)
}

const spotlightOn = pulse(false)

function toggleSpotlight() {
  spotlightOn.update((on) => !on)
}

const accentHue = pulse(140)

const theme = pulse('day')
const themes = ['day', 'dusk', 'night']

function setTheme(next) {
  theme.set(next)
}

const tone = pulse('ok')
const tones = ['ok', 'warn', 'danger']

function setTone(next) {
  tone.set(next)
}

const accents = pulse([
  { id: 'leaf', color: '#8fd12a' },
  { id: 'amber', color: '#f59e0b' },
  { id: 'rose', color: '#f43f5e' },
])

function shuffleAccents() {
  accents.update((list) => {
    const next = list.slice()
    const last = next.pop()
    if (last) next.unshift(last)
    return next
  })
}

export <view>
  <section class="page">
    <header class="page-hero">
      <p class="page-kicker">${t('css.kicker')}</p>
      <h1 class="page-title">${t('css.title')}</h1>
      <p class="page-lead">${t('css.lead')}</p>
    </header>

    <Tip :text=${t('css.tip')} />

    <div class="lesson-grid">
      <Demo :title=${t('css.demo.scoped.title')} :lead=${t('css.demo.scoped.lead')} :code=${scopedCode}>
        <div class="row">
          <ScopedA />
          <ScopedB />
        </div>
      </Demo>

      <Demo :title=${t('css.demo.global.title')} :lead=${t('css.demo.global.lead')} :code=${globalCode}>
        <div class="stack">
          <div class="row" class-shared-outline=${outlineOn}>
            <ScopedA />
            <ScopedB />
          </div>
          <button type="button" class="btn btn-outline" on-click=${toggleOutline}>${t('css.demo.global.toggle')}</button>
        </div>
      </Demo>

      <Demo :title=${t('css.demo.spotlight.title')} :lead=${t('css.demo.spotlight.lead')} :code=${spotlightCode}>
        <div class="stack">
          <div class="card" class-spotlight=${spotlightOn}>
            <p class="muted">${t('css.demo.spotlight.note')}</p>
          </div>
          <button type="button" class="btn btn-outline" on-click=${toggleSpotlight}>${t('css.demo.spotlight.toggle')}</button>
        </div>
      </Demo>

      <Demo :title=${t('css.demo.hue.title')} :lead=${t('css.demo.hue.lead')} :code=${hueChipCode}>
        <div class="stack">
          <div class="hue-chip" style---hue=${accentHue}></div>
          <input class="input" type="range" min="0" max="360" bind-value=${accentHue} />
        </div>
      </Demo>

      <Demo :title=${t('css.demo.styleIf.title')} :lead=${t('css.demo.styleIf.lead')} :code=${styleIfCode}>
        <div class="stack">
          <div class="row">
            #for themes as themeId (themeId)
              <button type="button" class="btn btn-outline" class-active=${() => theme() === themeId} on-click=${() => setTheme(themeId)}>${themeId}</button>
            #end
          </div>
          <div class="theme-card">
            <strong>${t('css.demo.styleIf.cardTitle')}</strong>
            <p>${t('css.demo.styleIf.cardBody')}</p>
          </div>
        </div>
      </Demo>

      <Demo :title=${t('css.demo.styleCase.title')} :lead=${t('css.demo.styleCase.lead')} :code=${styleCaseCode}>
        <div class="stack">
          <div class="row">
            #for tones as toneId (toneId)
              <button type="button" class="btn btn-outline" class-active=${() => tone() === toneId} on-click=${() => setTone(toneId)}>${toneId}</button>
            #end
          </div>
          <span class="tone-badge">${t('css.demo.styleCase.badge')}</span>
        </div>
      </Demo>

      <Demo :title=${t('css.demo.styleFor.title')} :lead=${t('css.demo.styleFor.lead')} :code=${styleForCode}>
        <div class="stack">
          <div class="row">
            #for accents() as accent (accent.id)
              <span class=${'chip-' + accent.id}>${accent.id}</span>
            #end
          </div>
          <button type="button" class="btn btn-outline" on-click=${shuffleAccents}>${t('css.demo.styleFor.rotate')}</button>
        </div>
      </Demo>
    </div>
  </section>
</view>

export <style>
:global(.shared-outline) {
  outline: 2px dashed color-mix(in srgb, var(--leaf) 45%, transparent);
  outline-offset: 3px;
  border-radius: 0.75rem;
}

.spotlight {
  background: linear-gradient(135deg, rgba(143, 209, 42, 0.32), rgba(31, 143, 78, 0.16));
  box-shadow: 0 0 0 2px var(--leaf) inset;
}

.hue-chip {
  --hue: 140;
  width: 3.5rem;
  height: 3.5rem;
  border-radius: 0.85rem;
  border: 1px solid var(--line);
  background: hsl(var(--hue) 70% 55%);
}

.theme-card {
  padding: 1rem 1.1rem;
  border-radius: 0.9rem;
  border: 1px solid transparent;

  #if theme() === 'night'
    background: #0b1a14;
    color: #e8f8dc;
    border-color: #1f8f4e;
  #elif theme() === 'dusk'
    background: #ffe8c7;
    color: #7a3e05;
    border-color: #f0b35a;
  #else
    background: #f8fffb;
    color: #0b1a14;
    border-color: color-mix(in srgb, var(--leaf) 25%, white);
  #end
}

.theme-card strong {
  display: block;
  margin-bottom: 0.35rem;
  font-family: var(--font-display);
}

.theme-card p {
  margin: 0;
  font-size: 0.9rem;
}

#case tone()
  #when 'ok'
.tone-badge {
  display: inline-block;
  padding: 0.35rem 0.75rem;
  border-radius: 999px;
  font-weight: 700;
  background: #dcfce7;
  color: #166534;
}
  #when 'warn'
.tone-badge {
  display: inline-block;
  padding: 0.35rem 0.75rem;
  border-radius: 999px;
  font-weight: 700;
  background: #fef3c7;
  color: #92400e;
}
  #when 'danger'
.tone-badge {
  display: inline-block;
  padding: 0.35rem 0.75rem;
  border-radius: 999px;
  font-weight: 700;
  background: #fee2e2;
  color: #991b1b;
}
  #else
.tone-badge {
  display: inline-block;
  padding: 0.35rem 0.75rem;
  border-radius: 999px;
  font-weight: 700;
  background: #f3f4f6;
  color: #374151;
}
#end

#for accents() as accent (accent.id)
.chip-${accent.id} {
  display: inline-block;
  padding: 0.35rem 0.7rem;
  border-radius: 999px;
  border: 1px solid ${accent.color};
  background: color-mix(in srgb, ${accent.color} 22%, white);
  font-size: 0.85rem;
  font-weight: 600;
}
#end
</style>
