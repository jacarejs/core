import { pulse } from '@jacare/core'
import Tip from '../components/Tip.jcr'
import Demo from '../components/Demo.jcr'
import { t } from '../i18n.js'
import { roleCode, statusCode, themeCode, numericCode } from '../snippets/case.js'

const role = pulse('member')
const roles = ['admin', 'guest', 'member']

function setRole(next) {
  role.set(next)
}

const status = pulse('loading')
const statuses = ['loading', 'error', 'empty', 'ready']

function setStatus(next) {
  status.set(next)
}

const theme = pulse('day')
const themes = ['day', 'dusk', 'night']

function setTheme(next) {
  theme.set(next)
}

const score = pulse(72)

function gradeKey() {
  const n = Number(score())
  if (n >= 90) return 'A'
  if (n >= 80) return 'B'
  if (n >= 70) return 'C'
  if (n >= 60) return 'D'
  return 'F'
}

export <view>
  <section class="page">
    <header class="page-hero">
      <p class="page-kicker">${t('case.kicker')}</p>
      <h1 class="page-title">${t('case.title')}</h1>
      <p class="page-lead">${t('case.lead')}</p>
    </header>

    <Tip :text=${t('case.tip')} />

    <div class="lesson-grid">
      <Demo :title=${t('case.demo.role.title')} :lead=${t('case.demo.role.lead')} :code=${roleCode}>
        <div class="stack">
          <div class="row">
            #for roles as r (r)
              <button type="button" class="btn btn-outline" class-active=${() => role() === r} on-click=${() => setRole(r)}>${r}</button>
            #end
          </div>
          #case role()
            #when 'admin'
              <p class="muted">${t('case.demo.role.admin')}</p>
            #when 'guest'
              <p class="muted">${t('case.demo.role.guest')}</p>
            #else
              <p class="muted">${t('case.demo.role.member')}</p>
          #end
        </div>
      </Demo>

      <Demo :title=${t('case.demo.status.title')} :lead=${t('case.demo.status.lead')} :code=${statusCode}>
        <div class="stack">
          <div class="row">
            #for statuses as s (s)
              <button type="button" class="btn btn-outline" class-active=${() => status() === s} on-click=${() => setStatus(s)}>${s}</button>
            #end
          </div>
          #case status()
            #when 'loading'
              <p class="muted" role="status" aria-live="polite">${t('case.demo.status.loading')}</p>
            #when 'error'
              <p class="muted">${t('case.demo.status.error')}</p>
            #when 'empty'
              <p class="muted">${t('case.demo.status.empty')}</p>
            #when 'ready'
              <p class="muted">${t('case.demo.status.ready')}</p>
            #else
              <p class="muted">${t('case.demo.status.unknown')}</p>
          #end
        </div>
      </Demo>

      <Demo :title=${t('case.demo.theme.title')} :lead=${t('case.demo.theme.lead')} :code=${themeCode}>
        <div class="stack">
          <div class="row">
            #for themes as themeId (themeId)
              <button
                type="button"
                class="btn btn-outline"
                class-active=${() => theme() === themeId}
                on-click=${() => setTheme(themeId)}
              >
                ${themeId}
              </button>
            #end
          </div>

          #case theme()
            #when 'day'
              <div class="theme-panel theme-day">
                <strong>${t('case.demo.theme.dayTitle')}</strong>
                <p>${t('case.demo.theme.dayBody')}</p>
              </div>
            #when 'dusk'
              <div class="theme-panel theme-dusk">
                <strong>${t('case.demo.theme.duskTitle')}</strong>
                <p>${t('case.demo.theme.duskBody')}</p>
              </div>
            #when 'night'
              <div class="theme-panel theme-night">
                <strong>${t('case.demo.theme.nightTitle')}</strong>
                <p>${t('case.demo.theme.nightBody')}</p>
              </div>
            #else
              <div class="theme-panel">
                <strong>${t('case.demo.theme.unknownTitle')}</strong>
                <p>${t('case.demo.theme.unknownBody')}</p>
              </div>
          #end
        </div>
      </Demo>

      <Demo :title=${t('case.demo.grade.title')} :lead=${t('case.demo.grade.lead')} :code=${numericCode}>
        <div class="stack">
          <input class="input" type="range" min="0" max="100" bind-value=${score} />
          <div class="row">
            <span class="metric">${score}</span>
            #case gradeKey()
              #when 'A'
                <span class="badge">${t('case.demo.grade.badge', { grade: 'A' })}</span>
              #when 'B'
                <span class="badge">${t('case.demo.grade.badge', { grade: 'B' })}</span>
              #when 'C'
                <span class="badge badge-warn">${t('case.demo.grade.badge', { grade: 'C' })}</span>
              #when 'D'
                <span class="badge badge-warn">${t('case.demo.grade.badge', { grade: 'D' })}</span>
              #else
                <span class="badge badge-danger">${t('case.demo.grade.badge', { grade: 'F' })}</span>
            #end
          </div>
        </div>
      </Demo>
    </div>
  </section>
</view>

export <style>
.theme-panel {
  padding: 1rem 1.1rem;
  border-radius: 0.9rem;
  border: 1px solid transparent;
  transition: background 0.2s ease, color 0.2s ease;
}

.theme-panel strong {
  display: block;
  margin-bottom: 0.35rem;
  font-family: var(--font-display);
  font-size: 1.15rem;
}

.theme-panel p {
  margin: 0;
  font-size: 0.9rem;
  line-height: 1.45;
}

.theme-day {
  background: linear-gradient(135deg, #e7f6ec, #f8fffb);
  border-color: color-mix(in srgb, var(--leaf) 25%, white);
  color: var(--ink);
}

.theme-dusk {
  background: linear-gradient(135deg, #ffe8c7, #ffd4a3);
  border-color: #f0b35a;
  color: #7a3e05;
}

.theme-night {
  background: linear-gradient(135deg, #0b3d2e, #061a14);
  border-color: #1f8f4e;
  color: #e8f8dc;
}
</style>
