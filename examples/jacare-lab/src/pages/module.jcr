import { pulse, derive } from '@jacare/core'
import Tip from '../components/Tip.jcr'
import Demo from '../components/Demo.jcr'
import Badge from '../components/Badge.jcr'
import { t, translate } from '../i18n.js'
import {
  layoutCode,
  viewSyntaxCode,
  styleSyntaxCode,
  compiledExportsCode,
  liveModuleCode,
} from '../snippets/module.js'

const title = pulse(translate('module.live.initial'))
const subtitle = derive(() => translate('module.live.updated', { value: title() }))

function onSave() {
  title.set(translate('module.live.saved'))
}

const exports = [
  { name: 'mount(target, props?)', roleKey: 'module.compiled.roles.mount' },
  { name: 'render(props?)', roleKey: 'module.compiled.roles.render' },
  { name: 'resume(target, state, props?)', roleKey: 'module.compiled.roles.resume' },
  { name: 'default', roleKey: 'module.compiled.roles.default' },
]

export <view>
  <section class="page">
    <header class="page-hero">
      <p class="page-kicker">${t('module.kicker')}</p>
      <h1 class="page-title">${t('module.title')}</h1>
      <p class="page-lead">${t('module.lead')}</p>
    </header>

    <Tip :text=${t('module.tip')} />

    <div class="lesson-grid">
      <Demo :title=${t('module.layout.title')} :lead=${t('module.layout.lead')} :code=${layoutCode}>
        <pre class="log">${layoutCode}</pre>
      </Demo>

      <Demo :title=${t('module.live.title')} :lead=${t('module.live.lead')} :code=${liveModuleCode}>
        <div class="stack">
          <p class="metric">${title}</p>
          <p class="muted">${subtitle}</p>
          <div class="row">
            <input class="input" bind-value=${title} />
            <button type="button" class="btn" on-click=${onSave}>${t('module.live.save')}</button>
          </div>
        </div>
      </Demo>

      <Demo :title=${t('module.viewSyntax.title')} :lead=${t('module.viewSyntax.lead')} :code=${viewSyntaxCode}>
        <div class="stack">
          <Badge :text=${t('module.viewSyntax.badge')} />
          <pre class="log">${viewSyntaxCode}</pre>
        </div>
      </Demo>

      <Demo :title=${t('module.styleSyntax.title')} :lead=${t('module.styleSyntax.lead')} :code=${styleSyntaxCode}>
        <pre class="log">${styleSyntaxCode}</pre>
      </Demo>

      <Demo :title=${t('module.compiled.title')} :lead=${t('module.compiled.lead')} :code=${compiledExportsCode}>
        <div class="nav-live">
          #for exports as item (item.name)
            <div class="nav-live-row">
              <span>${item.name}</span>
              <code>${t(item.roleKey)}</code>
            </div>
          #end
        </div>
      </Demo>
    </div>
  </section>
</view>
