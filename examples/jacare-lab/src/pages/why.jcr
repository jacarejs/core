import { pulse, derive } from '@jacare/core'
import Tip from '../components/Tip.jcr'
import Demo from '../components/Demo.jcr'
import { t, translate } from '../i18n.js'
import {
  consoleWhyCode,
  cliWhyCode,
  cycleWhyCode,
} from '../snippets/why.js'

const count = pulse(0, { name: 'count' })
const label = pulse('idle', { name: 'label' })
const labelText = derive(() =>
  label() === 'idle' || label() === 'once' ? translate('why.demo.' + label()) : label(),
)

function bump() {
  count.update((n) => n + 1)
  label.set(count() === 1 ? 'once' : `×${count()}`)
}

export <view>
  <section class="page">
    <header class="page-hero">
      <p class="page-kicker">${t('why.kicker')}</p>
      <h1 class="page-title">${t('why.title')}</h1>
      <p class="page-lead">${t('why.lead')}</p>
    </header>

    <Tip :text=${t('why.tip')} />

    <Demo :title=${t('why.demo.title')} :lead=${t('why.demo.lead')} :code=${consoleWhyCode}>
      <div class="stack">
        <div class="row">
          <button type="button" class="btn" on-click=${bump}>bump</button>
          <span class="badge why-demo-badge">${count}</span>
          <span class="muted">${labelText}</span>
        </div>
      </div>
    </Demo>

    <div class="ref-card">
      <h3>${t('why.console.title')}</h3>
      <pre><code>${consoleWhyCode}</code></pre>
    </div>

    <div class="ref-card">
      <h3>${t('why.cli.title')}</h3>
      <p class="muted">${t('why.cli.body')}</p>
      <pre><code>${cliWhyCode}</code></pre>
    </div>

    <div class="ref-card">
      <h3>${t('why.cycle.title')}</h3>
      <p class="muted">${t('why.cycle.body')}</p>
      <pre><code>${cycleWhyCode}</code></pre>
    </div>
  </section>
</view>

export <style>
.why-demo-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 2rem;
  padding: 0.2rem 0.55rem;
  border-radius: 999px;
  background: color-mix(in srgb, var(--accent, #2f6b4f) 18%, transparent);
  font-weight: 600;
}
</style>
