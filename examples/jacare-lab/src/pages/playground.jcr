import { createLifecycle, derive, effect, pulse } from '@jacare/core'
import { t, translate } from '../i18n.js'
import Tip from '../components/Tip.jcr'
import { DEFAULT_PLAYGROUND_SOURCE, PLAYGROUND_EXAMPLES } from '../playground/examples.js'
import { highlightJacare } from '../playground/highlight.js'
import { runPlayground } from '../playground/run.js'

const source = pulse(DEFAULT_PLAYGROUND_SOURCE)
const error = pulse('')
const status = pulse('ready')
const statusLabel = derive(() => translate(`playgroundPage.status.${status()}`))

let host = null
let highlightCode = null
let disposePreview = null
let timer = null

function exampleLabel(key) {
  return translate(`playgroundPage.example.${key}`)
}

function loadExample(id) {
  const example = PLAYGROUND_EXAMPLES.find((item) => item.id === id)
  if (!example) return
  source.set(example.source)
}

function paintHighlight() {
  if (!highlightCode) return
  highlightCode.innerHTML = highlightJacare(source())
}

function syncEditorScroll(event) {
  const layer = event.currentTarget.previousElementSibling
  if (!layer) return
  layer.scrollTop = event.currentTarget.scrollTop
  layer.scrollLeft = event.currentTarget.scrollLeft
}

function runNow() {
  if (!host) return
  try {
    disposePreview?.()
    disposePreview = null
    disposePreview = runPlayground(host, source())
    error.set('')
    status.set('live')
  } catch (err) {
    disposePreview?.()
    disposePreview = null
    host.replaceChildren()
    error.set(err?.message || String(err))
    status.set('error')
  }
}

function scheduleRun() {
  clearTimeout(timer)
  status.set('compiling')
  timer = setTimeout(runNow, 220)
}


export const lifecycle = createLifecycle({
  onMount() {
    let cancelled = false
    let tracker = null

    queueMicrotask(() => {
      if (cancelled) return
      host = document.getElementById('playground-host')
      highlightCode = document.getElementById('playground-highlight-code')
      if (!host) {
        error.set(translate('playgroundPage.hostMissing'))
        status.set('error')
        return
      }
      tracker = effect(() => {
        source()
        paintHighlight()
        scheduleRun()
      })
    })

    return () => {
      cancelled = true
      clearTimeout(timer)
      tracker?.dispose()
      disposePreview?.()
      disposePreview = null
      host = null
      highlightCode = null
    }
  },
})

export <view>
  <section class="page playground-page">
    <header class="page-hero">
      <p class="page-kicker">${t('playgroundPage.kicker')}</p>
      <h1 class="page-title">${t('playgroundPage.title')}</h1>
      <p class="page-lead">${t('playgroundPage.lead')}</p>
    </header>

    <Tip :text=${translate('playgroundPage.tip')} />

    <div class="row" style="margin-bottom: 0.75rem">
      <a class="btn" href="https://jacarejs.github.io/core/studio/" target="_blank" rel="noopener noreferrer">${t('playgroundPage.link.studio')}</a>
      <a class="btn btn-outline" href="https://github.com/jacarejs/core/blob/main/docs/api.md" target="_blank" rel="noopener noreferrer">${t('playgroundPage.link.apiDocs')}</a>
      <a class="btn btn-outline" href="https://github.com/jacarejs/core/blob/main/docs/language-reference.md" target="_blank" rel="noopener noreferrer">${t('playgroundPage.link.languageReference')}</a>
    </div>

    <div class="playground-toolbar">
      <div class="row">
        #for PLAYGROUND_EXAMPLES as example (example.id)
          <button type="button" class="btn btn-outline" on-click=${() => loadExample(example.id)}>
            ${exampleLabel(example.labelKey)}
          </button>
        #end
      </div>
      <span class="playground-status" class-error=${error().length > 0}>${statusLabel}</span>
    </div>

    <div class="playground-grid">
      <section class="playground-pane">
        <header class="playground-pane-head">
          <h2 class="playground-pane-title">${t('playgroundPage.sourceTitle')}</h2>
          <span class="muted">.jcr</span>
        </header>
        <div class="playground-editor-wrap">
          <pre class="playground-highlight" aria-hidden="true"><code id="playground-highlight-code"></code></pre>
          <textarea
            class="playground-editor"
            spellcheck="false"
            autocomplete="off"
            autocapitalize="off"
            bind-value=${source}
            on-scroll=${syncEditorScroll}
            aria-label=${translate('playgroundPage.editorAria')}
          ></textarea>
        </div>
      </section>

      <section class="playground-pane">
        <header class="playground-pane-head">
          <h2 class="playground-pane-title">${t('playgroundPage.previewTitle')}</h2>
          <span class="muted">${t('playgroundPage.previewNote')}</span>
        </header>
        #if error()
          <pre class="playground-error">${error}</pre>
        #end
        <div id="playground-host" class="playground-host"></div>
      </section>
    </div>
  </section>
</view>
