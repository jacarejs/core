import Tip from '../components/Tip.jcr'
import { appHref } from '../app-base.js'
import { t } from '../i18n.js'
import { lessonTitle } from '../topics.js'
import {
  overviewCode,
  siblingTsCode,
  siblingJcrCode,
  pragmaCode,
  importTsCode,
  dtsCode,
  rulesCode,
} from '../snippets/typescript.js'

const docsHref = 'https://github.com/jacarejs/core/blob/main/docs/syntax.md#typescript'

export <view>
  <section class="page">
    <header class="page-hero">
      <p class="page-kicker">${t('typescript.kicker')}</p>
      <h1 class="page-title">${t('typescript.title')}</h1>
      <p class="page-lead">
        ${t('typescript.lead', { sibling: '.jcr.ts', pragma: '// @jacare-ts', ts: '.ts' })}
      </p>
    </header>

    <Tip :text=${t('typescript.tip')} />

    <div class="ref-card">
      <h3>${t('typescript.overviewTitle')}</h3>
      <pre><code>${overviewCode}</code></pre>
    </div>

    <div class="ref-card">
      <h3>1 · ${t('typescript.sibling.titlePre')} <code>Foo.jcr.ts</code> ${t('typescript.sibling.titleNote')}</h3>
      <p class="muted">${t('typescript.sibling.body')}</p>
      <pre><code>${siblingTsCode}</code></pre>
      <pre><code>${siblingJcrCode}</code></pre>
    </div>

    <div class="ref-card">
      <h3>2 · ${t('typescript.pragma.titlePre')} <code>// @jacare-ts</code></h3>
      <p class="muted">${t('typescript.pragma.body')}</p>
      <pre><code>${pragmaCode}</code></pre>
    </div>

    <div class="ref-card">
      <h3>3 · ${t('typescript.importTs.titlePre')} <code>.ts</code> ${t('typescript.importTs.titlePost')}</h3>
      <p class="muted">${t('typescript.importTs.body')}</p>
      <pre><code>${importTsCode}</code></pre>
    </div>

    <div class="ref-card">
      <h3>4 · <code>jacare.d.ts</code> ${t('typescript.dts.titleSuffix')}</h3>
      <p class="muted">${t('typescript.dts.bodyPre')} <code>import App from './app.jcr'</code> ${t('typescript.dts.bodyPost')}</p>
      <pre><code>${dtsCode}</code></pre>
    </div>

    <div class="ref-card">
      <h3>${t('typescript.rulesTitle')}</h3>
      <pre><code>${rulesCode}</code></pre>
    </div>

    <p class="muted">
      ${t('typescript.alsoSee')}
      <a jacare-go="/module" href=${appHref('/module')}>${lessonTitle('module')}</a>
      ·
      <a jacare-go="/tooling" href=${appHref('/tooling')}>${t('typescript.toolingLink')}</a>
      ·
      <a href=${docsHref} target="_blank" rel="noopener noreferrer">syntax.md § TypeScript</a>
    </p>
  </section>
</view>
