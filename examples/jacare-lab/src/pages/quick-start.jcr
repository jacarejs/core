import { pulse } from '@jacare/core'
import Tip from '../components/Tip.jcr'
import Demo from '../components/Demo.jcr'
import { t } from '../i18n.js'
import {
  scaffoldCode,
  appJcrCode,
  bootJsCode,
  htmlShellCode,
} from '../snippets/quick-start.js'

const count = pulse(0)

function increment() {
  count.update((n) => n + 1)
}

export <view>
  <section class="page">
    <header class="page-hero">
      <p class="page-kicker">${t('quickStart.kicker')}</p>
      <h1 class="page-title">${t('quickStart.title')}</h1>
      <p class="page-lead">${t('quickStart.lead')}</p>
    </header>

    <Tip :text=${t('quickStart.tip')} />

    <div class="lesson-grid">
      <Demo :title=${t('quickStart.scaffold.title')} :lead=${t('quickStart.scaffold.lead')} :code=${scaffoldCode}>
        <div class="stack">
          <p class="muted">${t('quickStart.scaffold.note')} <code>http://localhost:3000</code>.</p>
          <pre class="log">${scaffoldCode}</pre>
        </div>
      </Demo>

      <Demo :title=${t('quickStart.app.title')} :lead=${t('quickStart.app.lead')} :code=${appJcrCode}>
        <div class="stack">
          <div class="row">
            <span class="metric">${count}</span>
            <button type="button" class="btn" on-click=${increment}>+1</button>
          </div>
          <p class="muted">${t('quickStart.app.note')}</p>
        </div>
      </Demo>

      <Demo :title=${t('quickStart.boot.title')} :lead=${t('quickStart.boot.lead')} :code=${bootJsCode}>
        <pre class="log">${bootJsCode}</pre>
      </Demo>

      <Demo :title=${t('quickStart.htmlShell.title')} :lead=${t('quickStart.htmlShell.lead')} :code=${htmlShellCode}>
        <pre class="log">${htmlShellCode}</pre>
      </Demo>
    </div>
  </section>
</view>
