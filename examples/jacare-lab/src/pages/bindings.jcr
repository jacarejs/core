import { pulse, derive } from '@jacare/core'
import Tip from '../components/Tip.jcr'
import Demo from '../components/Demo.jcr'
import { t, translate } from '../i18n.js'
import { mirrorCode, classCode, gaugeCode, numberBindCode, multiClassCode } from '../snippets/bindings.js'

const draft = pulse('')
const agreed = pulse(false)

const activeTag = pulse('templates')
const tags = ['reactivity', 'templates', 'bindings']

function selectTag(tag) {
  activeTag.set(tag)
}

const tasks = pulse([
  { id: 'docs', done: true },
  { id: 'demo', done: false },
  { id: 'ship', done: false },
])

function toggleTask(id) {
  tasks.update((list) => list.map((task) => (task.id === id ? { ...task, done: !task.done } : task)))
}

const gaugeValue = pulse(50)
const gaugeAngle = derive(() => (Number(gaugeValue()) / 100) * 180 + 'deg')

const quantity = pulse(1)
const unitPrice = 4.5
const total = derive(() => (Number(quantity()) * unitPrice).toFixed(2))

const priority = pulse('medium')
const priorities = ['low', 'medium', 'high']

function setPriority(next) {
  priority.set(next)
}

export <view>
  <section class="page">
    <header class="page-hero">
      <p class="page-kicker">${t('bindings.kicker')}</p>
      <h1 class="page-title">${t('bindings.title')}</h1>
      <p class="page-lead">${t('bindings.lead')}</p>
    </header>

    <Tip :text=${t('bindings.tip')} />

    <div class="lesson-grid">
      <Demo :title=${t('bindings.demo.mirror.title')} :lead=${t('bindings.demo.mirror.lead')} :code=${mirrorCode}>
        <div class="stack">
          <div class="row">
            <input class="input" bind-value=${draft} :placeholder=${translate('bindings.demo.mirror.placeholder')} />
            <input class="input" bind-value=${draft} :placeholder=${translate('bindings.demo.mirror.mirrorPlaceholder')} />
          </div>
          <div class="row">
            <label class="row"><input type="checkbox" bind-checked=${agreed} /> ${t('bindings.demo.mirror.agree')}</label>
            <label class="row"><input type="checkbox" bind-checked=${agreed} /> ${t('bindings.demo.mirror.mirrorCheckbox')}</label>
          </div>
        </div>
      </Demo>

      <Demo :title=${t('bindings.demo.classes.title')} :lead=${t('bindings.demo.classes.lead')} :code=${classCode}>
        <div class="stack">
          <div class="row">
            #for tags as tag (tag)
              <button type="button" class="btn btn-outline" class-active=${() => activeTag() === tag} on-click=${() => selectTag(tag)}>${tag}</button>
            #end
          </div>
          <ul class="list">
            #for tasks() as task (task.id)
              <li class="list-item" class-done=${task.done} on-click=${() => toggleTask(task.id)}>
                <span class="item-label">${t('bindings.demo.classes.tasks.' + task.id)}</span>
              </li>
            #end
          </ul>
        </div>
      </Demo>

      <Demo :title=${t('bindings.demo.gauge.title')} :lead=${t('bindings.demo.gauge.lead')} :code=${gaugeCode}>
        <div class="stack">
          <div class="gauge-mini" style---angle=${gaugeAngle}></div>
          <input class="input" type="range" min="0" max="100" bind-value=${gaugeValue} />
          <p class="muted">${gaugeValue}%</p>
        </div>
      </Demo>

      <Demo :title=${t('bindings.demo.number.title')} :lead=${t('bindings.demo.number.lead')} :code=${numberBindCode}>
        <div class="stack">
          <input class="input" type="number" min="1" max="99" bind-value=${quantity} />
          <p class="muted">${quantity} × $${unitPrice} = $${total}</p>
        </div>
      </Demo>

      <Demo :title=${t('bindings.demo.multiClass.title')} :lead=${t('bindings.demo.multiClass.lead')} :code=${multiClassCode}>
        <div class="row">
          #for priorities as level (level)
            <button
              type="button"
              class="btn btn-outline"
              class-active=${() => priority() === level}
              class-badge-warn=${() => level === 'medium' && priority() === level}
              class-badge-danger=${() => level === 'high' && priority() === level}
              on-click=${() => setPriority(level)}
            >
              ${t('bindings.demo.multiClass.levels.' + level)}
            </button>
          #end
        </div>
      </Demo>
    </div>
  </section>
</view>
