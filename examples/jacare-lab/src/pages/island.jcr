import { createLifecycle, derive, pulse } from '@jacare/core'
import { mountIsland } from '@jacare/core/island'
import { t, translate } from '../i18n.js'
import { lessonTitle } from '../topics.js'
import Tip from '../components/Tip.jcr'
import Demo from '../components/Demo.jcr'
import IslandCounter from '../components/IslandCounter.jcr'
import IslandTip from '../components/IslandTip.jcr'
import { appHref } from '../app-base.js'
import {
  basicMountCode,
  widgetSourceCode,
  propsRemountCode,
  shadowCode,
  optionsCode,
  disposeCode,
  howItWorksCode,
  whySubpathCode,
  reactHostCode,
  vueHostCode,
  angularHostCode,
  staticHostCode,
  viteHostCode,
} from '../snippets/island.js'

const basicLive = pulse(false)
const propsStart = pulse(2)
const propsLabel = derive(() => translate('islandPage.fromLabState'))
const propsLive = pulse(false)
const shadowLive = pulse(false)
const marked = pulse(false)

let disposeBasic
let disposeProps
let disposeShadow

function flag(on) {
  return translate(on ? 'islandPage.yes' : 'islandPage.no')
}

const basicLiveLabel = derive(() => flag(basicLive()))
const propsLiveLabel = derive(() => flag(propsLive()))
const shadowLiveLabel = derive(() => flag(shadowLive()))
const markLabel = derive(() =>
  translate(marked() ? 'islandPage.demo.basic.markSet' : 'islandPage.demo.basic.markCleared'),
)

function syncMark() {
  const el = document.querySelector('#lab-island-basic')
  marked.set(!!el?.hasAttribute('data-jacare-island'))
}

function mountBasic() {
  disposeBasic?.()
  disposeBasic = mountIsland('#lab-island-basic', IslandCounter, {
    props: { start: 3, label: translate('islandPage.labClicks') },
  })
  basicLive.set(true)
  syncMark()
}

function disposeBasicIsland() {
  disposeBasic?.()
  disposeBasic = null
  basicLive.set(false)
  syncMark()
}

function remountProps() {
  disposeProps?.()
  disposeProps = mountIsland('#lab-island-props', IslandCounter, {
    props: { start: propsStart(), label: propsLabel() },
  })
  propsLive.set(true)
}

function bumpStart() {
  propsStart.update((n) => n + 1)
  if (disposeProps?.update) {
    disposeProps.update({ start: propsStart(), label: propsLabel() })
    return
  }
  remountProps()
}

function mountShadow() {
  disposeShadow?.()
  disposeShadow = mountIsland('#lab-island-shadow', IslandTip, {
    props: { topic: 'lab · shadow' },
    shadow: true,
  })
  shadowLive.set(true)
}

function disposeShadowIsland() {
  disposeShadow?.()
  disposeShadow = null
  shadowLive.set(false)
}

export const lifecycle = createLifecycle({
  onMount() {
    let cancelled = false
    queueMicrotask(() => {
      if (cancelled) return
      mountBasic()
      remountProps()
      mountShadow()
    })
    return () => {
      cancelled = true
      disposeBasic?.()
      disposeProps?.()
      disposeShadow?.()
      disposeBasic = null
      disposeProps = null
      disposeShadow = null
    }
  },
})

export <view>
  <section class="page">
    <header class="page-hero">
      <p class="page-kicker">${t('islandPage.kicker')}</p>
      <h1 class="page-title">${t('islandPage.title')}</h1>
      <p class="page-lead">${t('islandPage.lead')}</p>
    </header>

    <Tip :text=${translate('islandPage.tip')} />

    <div class="lesson-grid">
      <Demo :title=${translate('islandPage.demo.basic.title')} :lead=${translate('islandPage.demo.basic.lead')} :code=${basicMountCode}>
        <div class="stack">
          <div id="lab-island-basic" class="lab-island-slot">
            <p class="muted">${t('islandPage.demo.basic.loading')}</p>
          </div>
          <div class="row">
            <button type="button" class="btn" on-click=${mountBasic}>${t('islandPage.remount')}</button>
            <button type="button" class="btn btn-outline" on-click=${disposeBasicIsland}>${t('islandPage.dispose')}</button>
          </div>
          <p class="muted">
            ${t('islandPage.demo.basic.live')} ${basicLiveLabel} ·
            ${t('islandPage.demo.basic.hostMark')} <code>data-jacare-island</code>: ${markLabel}
          </p>
        </div>
      </Demo>

      <Demo :title=${translate('islandPage.demo.widget.title')} :lead=${translate('islandPage.demo.widget.lead')} :code=${widgetSourceCode}>
        <p class="muted">${t('islandPage.demo.widget.note')}</p>
      </Demo>

      <Demo :title=${translate('islandPage.demo.props.title')} :lead=${translate('islandPage.demo.props.lead')} :code=${propsRemountCode}>
        <div class="stack">
          <div class="row">
            <button type="button" class="btn btn-outline" on-click=${bumpStart}>
              start = ${propsStart}
            </button>
            <button type="button" class="btn btn-ghost" on-click=${remountProps}>${t('islandPage.remount')}</button>
          </div>
          <div id="lab-island-props" class="lab-island-slot"></div>
          <p class="muted">${t('islandPage.demo.props.label')} ${propsLabel} · ${t('islandPage.demo.props.mounted')} ${propsLiveLabel}</p>
        </div>
      </Demo>

      <Demo :title=${translate('islandPage.demo.shadow.title')} :lead=${translate('islandPage.demo.shadow.lead')} :code=${shadowCode}>
        <div class="stack lab-island-host-clash">
          <p class="lab-island-clash-note">${t('islandPage.demo.shadow.clash')}</p>
          <div id="lab-island-shadow" class="lab-island-slot">
            <p class="muted">${t('islandPage.demo.shadow.loading')}</p>
          </div>
          <div class="row">
            <button type="button" class="btn" on-click=${mountShadow}>${t('islandPage.demo.shadow.remount')}</button>
            <button type="button" class="btn btn-outline" on-click=${disposeShadowIsland}>${t('islandPage.dispose')}</button>
          </div>
          <p class="muted">${t('islandPage.demo.shadow.live')} ${shadowLiveLabel}</p>
        </div>
      </Demo>

      <Demo :title=${translate('islandPage.demo.options.title')} :lead=${translate('islandPage.demo.options.lead')} :code=${optionsCode}>
        <ul class="list">
          <li class="list-item"><span class="item-label"><code>props</code></span> ${t('islandPage.demo.options.props')}</li>
          <li class="list-item"><span class="item-label"><code>shadow</code></span> — <code>true</code> / <code>open</code> / <code>closed</code></li>
          <li class="list-item"><span class="item-label"><code>clear</code></span> ${t('islandPage.demo.options.clear1')} <code>true</code>${t('islandPage.demo.options.clear2')}</li>
          <li class="list-item"><span class="item-label"><code>mark</code></span> ${t('islandPage.demo.options.mark1')} <code>false</code> ${t('islandPage.demo.options.mark2')}</li>
        </ul>
      </Demo>

      <Demo :title=${translate('islandPage.demo.dispose.title')} :lead=${translate('islandPage.demo.dispose.lead')} :code=${disposeCode}>
        <p class="muted">${t('islandPage.demo.dispose.note')}</p>
      </Demo>

      <Demo :title=${translate('islandPage.demo.how.title')} :lead=${translate('islandPage.demo.how.lead')} :code=${howItWorksCode}>
        <p class="muted">${t('islandPage.demo.how.note')}</p>
      </Demo>

      <Demo :title=${translate('islandPage.demo.subpath.title')} :lead=${translate('islandPage.demo.subpath.lead')} :code=${whySubpathCode}>
        <p class="muted">${t('islandPage.demo.subpath.note')}</p>
      </Demo>

      <Demo :title=${translate('islandPage.demo.static.title')} :lead=${translate('islandPage.demo.static.lead')} :code=${staticHostCode}>
        <p class="muted">
          ${t('islandPage.liveDemo')}
          <a class="text-link" href="https://jacarejs.github.io/core/island/" target="_blank" rel="noreferrer">jacare-island</a>
          · ${t('islandPage.local')} <code>yarn island:dev</code> (:3006)
        </p>
      </Demo>

      <Demo :title=${translate('islandPage.demo.vite.title')} :lead=${translate('islandPage.demo.vite.lead')} :code=${viteHostCode}>
        <p class="muted">${t('islandPage.demo.vite.note')}</p>
      </Demo>

      <Demo :title=${translate('islandPage.demo.react.title')} :lead=${translate('islandPage.demo.react.lead')} :code=${reactHostCode}>
        <p class="muted">
          <a class="text-link" href="https://jacarejs.github.io/core/island-react/" target="_blank" rel="noreferrer">Island × React</a>
          · <code>yarn island-react:dev</code> (:3007)
        </p>
      </Demo>

      <Demo :title=${translate('islandPage.demo.vue.title')} :lead=${translate('islandPage.demo.vue.lead')} :code=${vueHostCode}>
        <p class="muted">
          <a class="text-link" href="https://jacarejs.github.io/core/island-vue/" target="_blank" rel="noreferrer">Island × Vue</a>
          · <code>yarn island-vue:dev</code> (:3008)
        </p>
      </Demo>

      <Demo :title=${translate('islandPage.demo.angular.title')} :lead=${translate('islandPage.demo.angular.lead')} :code=${angularHostCode}>
        <p class="muted">
          <a class="text-link" href="https://jacarejs.github.io/core/island-angular/" target="_blank" rel="noreferrer">Island × Angular</a>
          · <code>yarn island-angular:dev</code> (:3009).
          ${t('islandPage.demo.angular.escape')}
        </p>
      </Demo>
    </div>

    <aside class="page-aside">
      <h2 class="page-aside-title">${t('islandPage.aside.title')}</h2>
      <div class="row">
        <a class="btn btn-outline" jacare-go="/ssr" href=${appHref('/ssr')}>${t('islandPage.aside.ssr')}</a>
        <a class="btn btn-outline" jacare-go="/helpers" href=${appHref('/helpers')}>${lessonTitle('helpers')}</a>
        <a class="btn btn-outline" jacare-go="/module" href=${appHref('/module')}>${t('islandPage.aside.module')}</a>
      </div>
      <p class="muted">${t('islandPage.aside.guide')} <code>docs/island.md</code> ${t('islandPage.aside.api')} <code>docs/api.md</code> §14b</p>
    </aside>
  </section>
</view>

export <style>
.lab-island-slot {
  min-height: 4.5rem;
  padding: 0.75rem 0.85rem;
  border: 1px dashed var(--j-border, #c9d9ce);
  border-radius: 0.55rem;
  background: rgba(255, 255, 255, 0.55);
}

.lab-island-host-clash {
  font-family: Georgia, 'Times New Roman', serif;
}

.lab-island-clash-note {
  margin: 0;
  text-decoration: underline;
  color: #6b2b1a;
}

.page-aside {
  margin-top: 1.5rem;
  padding: 1rem 1.1rem;
  border: 1px solid var(--j-border, #c9d9ce);
  border-radius: 0.65rem;
  display: grid;
  gap: 0.75rem;
}

.page-aside-title {
  margin: 0;
  font-size: 0.95rem;
}
</style>
