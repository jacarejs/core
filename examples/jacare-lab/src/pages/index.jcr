import { pulse, derive } from '@jacare/core'
import { appHref, assetUrl } from '../app-base.js'
import { LESSONS, lessonTitle, lessonBlurb } from '../topics.js'
import { t, translate } from '../i18n.js'
import Demo from '../components/Demo.jcr'
import Tip from '../components/Tip.jcr'
import { quickStartCode, bootCode, greetingCode, highlightCode } from '../snippets/start.js'

const quickCount = pulse(0)

function increment() {
  quickCount.update((n) => n + 1)
}

const learnerName = pulse('friend')
const greeting = derive(() => translate('home.hello', { name: learnerName() }))

const highlighted = pulse(false)

function toggleHighlight() {
  highlighted.update((on) => !on)
}

const installCreate = `npm create jacare@latest my-app
cd my-app && npm install && npm run dev`

const installCli = `npm install -g @jacare/cli
jacare new my-app
cd my-app && npm install && jacare dev`

const startDev = `npm run dev
jacare dev`

export <view>
  <section class="page">
    <header class="page-hero">
      <img class="lab-logo" src=${assetUrl('jacare-logo.png')} alt="Jacaré" />
      <h1 class="page-title lab-brand">${t('home.title')}</h1>
      <p class="page-lead">${t('home.lead')}</p>
      <div class="lab-links">
        <a
          class="lab-badge-link"
          href="https://www.npmjs.com/package/@jacare/core"
          target="_blank"
          rel="noopener noreferrer"
        >
          <img
            class="lab-badge"
            src="https://img.shields.io/npm/v/@jacare/core.svg?label=%40jacare%2Fcore&color=189030"
            alt="@jacare/core on npm"
          />
        </a>
        <a
          class="lab-badge-link"
          href="https://jacarejs.github.io/core/lab/"
          target="_blank"
          rel="noopener noreferrer"
        >
          <img
            class="lab-badge"
            src="https://img.shields.io/badge/demo-Lab-78c018.svg"
            alt="Jacaré Lab live demo"
          />
        </a>
        <a
          class="lab-repo-link"
          href="https://github.com/jacarejs/core"
          target="_blank"
          rel="noopener noreferrer"
        >
          ${t('home.github')}
        </a>
      </div>
    </header>

    <Tip :text=${translate('home.tip')} />

    <div class="intro-stack">
      <article class="intro-card">
        <h2 class="intro-title">${t('home.whatTitle')}</h2>
        <p class="intro-copy">${t('home.whatBody1')}</p>
        <p class="intro-copy">${t('home.whatBody2')}</p>
      </article>

      <article class="intro-card">
        <h2 class="intro-title">${t('home.installTitle')}</h2>
        <p class="intro-copy">${t('home.installBody1')}</p>
        <pre class="log">${installCreate}</pre>
        <p class="intro-copy">${t('home.installBody2')}</p>
        <pre class="log">${installCli}</pre>
      </article>

      <article class="intro-card">
        <h2 class="intro-title">${t('home.startTitle')}</h2>
        <p class="intro-copy">${t('home.startBody1')}</p>
        <pre class="log">${startDev}</pre>
        <p class="intro-copy">${t('home.startBody2')}</p>
      </article>
    </div>

    <div class="lesson-grid">
      <Demo :title=${translate('home.demo.quick.title')} :lead=${translate('home.demo.quick.lead')} :code=${quickStartCode}>
        <div class="stack">
          <div class="row">
            <span class="metric">${quickCount}</span>
            <button type="button" class="btn" on-click=${increment}>+1</button>
          </div>
          <p class="muted">${t('home.demo.quick.note')}</p>
        </div>
      </Demo>

      <Demo :title=${translate('home.demo.boot.title')} :lead=${translate('home.demo.boot.lead')} :code=${bootCode}>
        <div class="stack">
          <p class="muted">${t('home.demo.boot.note')}</p>
        </div>
      </Demo>

      <Demo :title=${translate('home.demo.greeting.title')} :lead=${translate('home.demo.greeting.lead')} :code=${greetingCode}>
        <div class="stack">
          <input class="input" bind-value=${learnerName} placeholder=${translate('home.namePlaceholder')} />
          <p class="metric">${greeting}</p>
        </div>
      </Demo>

      <Demo :title=${translate('home.demo.highlight.title')} :lead=${translate('home.demo.highlight.lead')} :code=${highlightCode}>
        <div class="row">
          <span class="badge" class-badge-warn=${highlighted}>${t('home.demo.highlight.badge')}</span>
          <button type="button" class="btn btn-outline" on-click=${toggleHighlight}>${t('home.demo.highlight.toggle')}</button>
        </div>
      </Demo>
    </div>

    <div class="home-grid">
      #for LESSONS as lesson (lesson.path)
        <a class="home-card" jacare-go=${lesson.path} href=${appHref(lesson.path)}>
          <strong>${lessonTitle(lesson.id)}</strong>
          <span>${lessonBlurb(lesson.id)}</span>
        </a>
      #end
    </div>
  </section>
</view>

export <style>
.page-hero {
  justify-items: start;
  text-align: left;
}
.lab-logo {
  width: min(8.5rem, 36vw);
  height: auto;
  filter: drop-shadow(0 16px 28px rgba(6, 26, 20, 0.18));
  animation: lab-breathe 4.5s ease-in-out infinite;
}
.lab-brand {
  font-size: clamp(2.4rem, 7vw, 3.4rem);
  letter-spacing: -0.04em;
}
.lab-links {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 0.65rem 0.85rem;
  margin-top: 0.15rem;
}
.lab-badge {
  display: block;
  height: 1.25rem;
}
.lab-repo-link {
  display: inline-flex;
  align-items: center;
  gap: 0.35rem;
  padding: 0.28rem 0.7rem;
  border-radius: 999px;
  border: 1px solid color-mix(in srgb, var(--canopy) 22%, white);
  background: rgba(255, 255, 255, 0.72);
  color: var(--canopy);
  font-size: 0.82rem;
  font-weight: 700;
  text-decoration: none;
  transition: background 0.15s ease, border-color 0.15s ease, transform 0.15s ease;
}
.lab-repo-link:hover {
  background: rgba(143, 209, 42, 0.18);
  border-color: color-mix(in srgb, var(--lime) 45%, var(--line));
  transform: translateY(-1px);
}
@keyframes lab-breathe {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-4px); }
}
.intro-stack {
  display: grid;
  gap: 0.85rem;
}
.intro-card {
  display: grid;
  gap: 0.65rem;
  padding: 1rem 1.1rem 1.15rem;
  border-radius: calc(var(--radius) + 0.15rem);
  border: 1px solid var(--line);
  background: var(--panel);
  box-shadow: var(--shadow);
}
.intro-title {
  margin: 0;
  font-family: var(--font-display);
  font-size: 1.2rem;
  font-weight: 600;
  letter-spacing: -0.02em;
}
.intro-copy {
  margin: 0;
  font-size: 0.92rem;
  line-height: 1.5;
  color: var(--muted);
  max-width: 68ch;
}
.intro-copy code {
  font-size: 0.86em;
}
</style>
