import { pulse, derive } from '@jacare/core'
import Tip from '../components/Tip.jcr'
import Demo from '../components/Demo.jcr'
import { t, translate } from '../i18n.js'
import { stateCode, nestedCode, siblingCode, gradeCode, emptyResultsCode, themeBgCode, jacareWhenCode } from '../snippets/conditionals.js'

const state = pulse('loading')
const states = ['loading', 'error', 'empty', 'ready']

function setState(next) {
  state.set(next)
}

const user = pulse(null)

function login(role) {
  user.set({ name: role === 'admin' ? 'Ana' : 'Beto', admin: role === 'admin' })
}

function logout() {
  user.set(null)
}

const userName = derive(() => user()?.name ?? '')
const adminWelcome = derive(() => translate('conditionals.demo.nested.admin', { name: userName() }))
const memberWelcome = derive(() => translate('conditionals.demo.nested.member', { name: userName() }))

const cartCount = pulse(0)

function addToCart() {
  cartCount.update((n) => n + 1)
}

function clearCart() {
  cartCount.set(0)
}

const cartLabel = derive(() => translate('conditionals.demo.siblings.count', { n: cartCount() }))

const score = pulse(72)
const grade = derive(() => {
  const n = Number(score())
  if (n >= 90) return 'A'
  if (n >= 80) return 'B'
  if (n >= 70) return 'C'
  if (n >= 60) return 'D'
  return 'F'
})
const gradeBadge = derive(() => translate('conditionals.demo.grade.badge', { grade: grade() }))

const contacts = pulse([
  { id: 'a', name: 'Ada Lovelace' },
  { id: 'b', name: 'Grace Hopper' },
  { id: 'c', name: 'Alan Turing' },
])
const query = pulse('')
const results = derive(() => {
  const q = query().trim().toLowerCase()
  if (!q) return contacts()
  return contacts().filter((person) => person.name.toLowerCase().includes(q))
})
const noMatchesLabel = derive(() => translate('conditionals.demo.empty.noMatches', { query: query() }))

const theme = pulse('day')
const themes = ['day', 'dusk', 'night']

function setTheme(next) {
  theme.set(next)
}

const showHint = pulse(true)

function toggleHint() {
  showHint.update((v) => !v)
}

export <view>
  <section class="page">
    <header class="page-hero">
      <p class="page-kicker">${t('conditionals.kicker')}</p>
      <h1 class="page-title">${t('conditionals.title')}</h1>
      <p class="page-lead">${t('conditionals.lead')}</p>
    </header>

    <Tip :text=${t('conditionals.tip')} />

    <div class="lesson-grid">
      <Demo :title=${t('conditionals.demo.state.title')} :lead=${t('conditionals.demo.state.lead')} :code=${stateCode}>
        <div class="stack">
          <div class="row">
            #for states as s (s)
              <button type="button" class="btn btn-outline" class-active=${() => state() === s} on-click=${() => setState(s)}>${s}</button>
            #end
          </div>
          #if state() === 'loading'
            <p class="muted" role="status" aria-live="polite">${t('conditionals.demo.state.loading')}</p>
          #elif state() === 'error'
            <p class="muted">${t('conditionals.demo.state.error')}</p>
          #elif state() === 'empty'
            <p class="muted">${t('conditionals.demo.state.empty')}</p>
          #else
            <p class="muted">${t('conditionals.demo.state.ready')}</p>
          #end
        </div>
      </Demo>

      <Demo :title=${t('conditionals.demo.nested.title')} :lead=${t('conditionals.demo.nested.lead')} :code=${nestedCode}>
        <div class="stack">
          <div class="row">
            <button type="button" class="btn" on-click=${() => login('admin')}>${t('conditionals.demo.nested.loginAdmin')}</button>
            <button type="button" class="btn btn-outline" on-click=${() => login('member')}>${t('conditionals.demo.nested.loginMember')}</button>
            <button type="button" class="btn btn-ghost" on-click=${logout}>${t('conditionals.demo.nested.logout')}</button>
          </div>
          #if user()
            #if user().admin
              <p class="muted">${adminWelcome}</p>
            #else
              <p class="muted">${memberWelcome}</p>
            #end
          #else
            <p class="muted">${t('conditionals.demo.nested.anonymous')}</p>
          #end
        </div>
      </Demo>

      <Demo :title=${t('conditionals.demo.siblings.title')} :lead=${t('conditionals.demo.siblings.lead')} :code=${siblingCode}>
        <div class="stack">
          #if cartCount() > 0
            <p class="muted">${cartLabel}</p>
            <div class="row">
              <button type="button" class="btn" on-click=${addToCart}>${t('conditionals.demo.siblings.addMore')}</button>
              <button type="button" class="btn btn-outline" on-click=${clearCart}>${t('conditionals.demo.siblings.clear')}</button>
            </div>
          #else
            <p class="muted">${t('conditionals.demo.siblings.empty')}</p>
            <button type="button" class="btn" on-click=${addToCart}>${t('conditionals.demo.siblings.add')}</button>
          #end
        </div>
      </Demo>

      <Demo :title=${t('conditionals.demo.grade.title')} :lead=${t('conditionals.demo.grade.lead')} :code=${gradeCode}>
        <div class="stack">
          <input class="input" type="range" min="0" max="100" bind-value=${score} />
          <div class="row">
            <span class="metric">${score}</span>
            #if score() >= 90
              <span class="badge">${gradeBadge}</span>
            #elif score() >= 80
              <span class="badge">${gradeBadge}</span>
            #elif score() >= 70
              <span class="badge badge-warn">${gradeBadge}</span>
            #elif score() >= 60
              <span class="badge badge-warn">${gradeBadge}</span>
            #else
              <span class="badge badge-danger">${gradeBadge}</span>
            #end
          </div>
        </div>
      </Demo>

      <Demo :title=${t('conditionals.demo.empty.title')} :lead=${t('conditionals.demo.empty.lead')} :code=${emptyResultsCode}>
        <div class="stack">
          <input class="input" bind-value=${query} placeholder=${t('conditionals.demo.empty.placeholder')} />
          #if results().length === 0
            <p class="muted">${noMatchesLabel}</p>
          #else
            <ul class="list">
              #for results() as person (person.id)
                <li class="list-item"><span class="item-label">${person.name}</span></li>
              #end
            </ul>
          #end
        </div>
      </Demo>

      <Demo :title=${t('conditionals.demo.themeBg.title')} :lead=${t('conditionals.demo.themeBg.lead')} :code=${themeBgCode}>
        <div class="stack">
          <div class="row">
            #for themes as themeId (themeId)
              <button
                type="button"
                class="btn btn-outline"
                class-active=${() => theme() === themeId}
                on-click=${() => setTheme(themeId)}
              >
                ${themeId}
              </button>
            #end
          </div>

          #if theme() === 'day'
            <div class="theme-panel theme-day">
              <strong>${t('conditionals.demo.themeBg.dayTitle')}</strong>
              <p>${t('conditionals.demo.themeBg.dayBody')}</p>
            </div>
          #elif theme() === 'dusk'
            <div class="theme-panel theme-dusk">
              <strong>${t('conditionals.demo.themeBg.duskTitle')}</strong>
              <p>${t('conditionals.demo.themeBg.duskBody')}</p>
            </div>
          #else
            <div class="theme-panel theme-night">
              <strong>${t('conditionals.demo.themeBg.nightTitle')}</strong>
              <p>${t('conditionals.demo.themeBg.nightBody')}</p>
            </div>
          #end
        </div>
      </Demo>

      <Demo :title=${t('conditionals.demo.when.title')} :lead=${t('conditionals.demo.when.lead')} :code=${jacareWhenCode}>
        <div class="stack">
          <button type="button" class="btn btn-outline" on-click=${toggleHint}>${t('conditionals.demo.when.toggle')}</button>
          <p jacare-when=${showHint} class="muted" role="status">
            ${t('conditionals.demo.when.hint')}
          </p>
        </div>
      </Demo>
    </div>
  </section>
</view>

export <style>
.theme-panel {
  padding: 1rem 1.1rem;
  border-radius: 0.9rem;
  border: 1px solid transparent;
  transition: background 0.2s ease, color 0.2s ease;
}

.theme-panel strong {
  display: block;
  margin-bottom: 0.35rem;
  font-family: var(--font-display);
  font-size: 1.15rem;
}

.theme-panel p {
  margin: 0;
  font-size: 0.9rem;
  line-height: 1.45;
}

.theme-day {
  background: linear-gradient(135deg, #e7f6ec, #f8fffb);
  border-color: color-mix(in srgb, var(--leaf) 25%, white);
  color: var(--ink);
}

.theme-dusk {
  background: linear-gradient(135deg, #ffe8c7, #ffd4a3);
  border-color: #f0b35a;
  color: #7a3e05;
}

.theme-night {
  background: linear-gradient(135deg, #0b3d2e, #061a14);
  border-color: #1f8f4e;
  color: #e8f8dc;
}
</style>
