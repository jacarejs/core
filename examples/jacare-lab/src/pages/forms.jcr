import { createForm, derive, pulse } from '@jacare/core'
import { t, translate } from '../i18n.js'
import Tip from '../components/Tip.jcr'
import Demo from '../components/Demo.jcr'
import Field from '../components/Field.jcr'
import { formCode, touchedDirtyCode, confirmCode, multiValidatorCode } from '../snippets/forms.js'

const form = createForm({
  name: {
    value: '',
    validate: (value) =>
      value.trim().length < 2 ? translate('formsPage.error.nameShort') : undefined,
  },
  email: {
    value: '',
    validate: (value) => (value.includes('@') ? undefined : translate('formsPage.error.email')),
  },
})

const newsletter = pulse(false)
const submittedValues = pulse(null)

const onSubmit = form.handleSubmit((values) => {
  submittedValues.set({ name: values.name, email: values.email, newsletter: newsletter() })
})

function resetForm() {
  form.reset()
  newsletter.set(false)
  submittedValues.set(null)
}

const password = pulse('')
const confirmForm = createForm({
  confirm: {
    value: '',
    validate: (value) =>
      value.length > 0 && value !== password() ? translate('formsPage.error.mismatch') : undefined,
  },
})

const signupForm = createForm({
  username: {
    value: '',
    validate: [
      (value) =>
        value.trim().length < 3 ? translate('formsPage.error.usernameShort') : undefined,
      (value) => (/\s/.test(value) ? translate('formsPage.error.usernameSpaces') : undefined),
    ],
  },
})

function flag(on) {
  return translate(on ? 'formsPage.yes' : 'formsPage.no')
}

const formState = derive(() =>
  translate('formsPage.state', { valid: flag(form.valid()), dirty: flag(form.dirty()) }),
)
const nameTouchedLabel = derive(() =>
  translate('formsPage.badge.nameTouched', { value: flag(form.fields.name.touched()) }),
)
const nameDirtyLabel = derive(() =>
  translate('formsPage.badge.nameDirty', { value: flag(form.fields.name.dirty()) }),
)
const emailTouchedLabel = derive(() =>
  translate('formsPage.badge.emailTouched', { value: flag(form.fields.email.touched()) }),
)

export <view>
  <section class="page">
    <header class="page-hero">
      <p class="page-kicker">${t('formsPage.kicker')}</p>
      <h1 class="page-title">${t('formsPage.title')}</h1>
      <p class="page-lead">${t('formsPage.lead')}</p>
    </header>

    <Tip :text=${translate('formsPage.tip')} />

    <div class="lesson-grid">
      <Demo :title=${translate('formsPage.demo.schema.title')} :lead=${translate('formsPage.demo.schema.lead')} :code=${formCode}>
        <form class="stack" on-submit=${onSubmit}>
          <Field
            :label=${translate('formsPage.field.name')}
            bind-value=${form.fields.name}
            :error=${form.fields.name.error()}
            :type=${'text'}
            :placeholder=${'Ada Lovelace'}
            on-blur=${() => form.fields.name.blur()}
          />
          <Field
            :label=${translate('formsPage.field.email')}
            bind-value=${form.fields.email}
            :error=${form.fields.email.error()}
            :type=${'email'}
            :placeholder=${'you@jacare.dev'}
            on-blur=${() => form.fields.email.blur()}
          />
          <label class="row"><input type="checkbox" bind-checked=${newsletter} /> ${t('formsPage.newsletter')}</label>
          <div class="row">
            <button type="submit" class="btn">${t('formsPage.submit')}</button>
            <button type="button" class="btn btn-outline" on-click=${resetForm}>${t('formsPage.reset')}</button>
          </div>
        </form>
      </Demo>

      <Demo :title=${translate('formsPage.demo.submit.title')} :lead=${translate('formsPage.demo.submit.lead')} :code=${formCode}>
        <div class="stack">
          <p class="muted">${formState}</p>
          #if submittedValues()
            <p class="muted">${t('formsPage.submitted')} ${() => JSON.stringify(submittedValues())}</p>
          #else
            <p class="muted">${t('formsPage.empty')}</p>
          #end
        </div>
      </Demo>

      <Demo :title=${translate('formsPage.demo.fieldState.title')} :lead=${translate('formsPage.demo.fieldState.lead')} :code=${touchedDirtyCode}>
        <div class="stack">
          <div class="row">
            <span class="badge" class-badge-warn=${form.fields.name.touched()}>${nameTouchedLabel}</span>
            <span class="badge" class-badge-warn=${form.fields.name.dirty()}>${nameDirtyLabel}</span>
            <span class="badge" class-badge-warn=${form.fields.email.touched()}>${emailTouchedLabel}</span>
          </div>
          <p class="muted">${t('formsPage.stateHint')}</p>
        </div>
      </Demo>

      <Demo :title=${translate('formsPage.demo.confirm.title')} :lead=${translate('formsPage.demo.confirm.lead')} :code=${confirmCode}>
        <div class="stack">
          <label class="field">
            <span class="field-label">${t('formsPage.field.password')}</span>
            <input class="input" type="password" bind-value=${password} />
          </label>
          <Field
            :label=${translate('formsPage.field.confirm')}
            bind-value=${confirmForm.fields.confirm}
            :error=${confirmForm.fields.confirm.error()}
            :type=${'password'}
            :placeholder=${translate('formsPage.confirmPlaceholder')}
            on-blur=${() => confirmForm.fields.confirm.blur()}
          />
        </div>
      </Demo>

      <Demo :title=${translate('formsPage.demo.multi.title')} :lead=${translate('formsPage.demo.multi.lead')} :code=${multiValidatorCode}>
        <Field
          :label=${translate('formsPage.field.username')}
          bind-value=${signupForm.fields.username}
          :error=${signupForm.fields.username.error()}
          :type=${'text'}
          :placeholder=${'jacare_dev'}
          on-blur=${() => signupForm.fields.username.blur()}
        />
      </Demo>
    </div>
  </section>
</view>
