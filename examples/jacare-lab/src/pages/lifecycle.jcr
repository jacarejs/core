import { createLifecycle, derive, effect, pulse, registerScope } from '@jacare/core'
import { appHref } from '../app-base.js'
import { showCode } from '../code-viewer.js'
import { t, translate } from '../i18n.js'
import { lessonTitle } from '../topics.js'
import Tip from '../components/Tip.jcr'
import Demo from '../components/Demo.jcr'
import Badge from '../components/Badge.jcr'
import {
  cycleFlowCode,
  titleCode,
  hooksCode,
  scopeCode,
  activationCode,
  disposeCode,
} from '../snippets/lifecycle.js'

const ticks = pulse(0)
const activations = pulse(0)
const deactivations = pulse(0)
const unmounts = pulse(0)
const activePhase = pulse('active')
const phaseLabel = derive(() => translate(`lifecyclePage.phase.${activePhase()}`))
let timer


export const lifecycle = createLifecycle({
  onMount() {
    timer = setInterval(() => ticks.update((n) => n + 1), 1000)
    activePhase.set('mounted')
    return () => clearInterval(timer)
  },
  onActivate() {
    activations.update((n) => n + 1)
    activePhase.set('active')
    return registerScope('lab-lifecycle.ticks', 'Lifecycle ticks', () => ticks())
  },
  onDeactivate() {
    deactivations.update((n) => n + 1)
    activePhase.set('deactivated')
  },
  onUnmount() {
    unmounts.update((n) => n + 1)
    activePhase.set('unmounted')
  },
})

const showBlock = pulse(true)
const mounts = pulse(0)
const disposals = pulse(0)

effect(() => {
  if (!showBlock()) return
  mounts.update((n) => n + 1)
  return () => disposals.update((n) => n + 1)
})

function toggleBlock() {
  showBlock.update((on) => !on)
}

const blockToggleLabel = derive(() =>
  translate(
    showBlock() ? 'lifecyclePage.demo.dispose.unmountBlock' : 'lifecyclePage.demo.dispose.mountBlock',
  ),
)

const quickLinks = [
  { path: '/reactivity', id: 'reactivity' },
  { path: '/nav', id: 'nav' },
  { path: '/forms', id: 'forms' },
]

export <view>
  <section class="page page-lifecycle">
    <header class="page-hero">
      <p class="page-kicker">${t('lifecyclePage.kicker')}</p>
      <h1 class="page-title">${t('lifecyclePage.title')}</h1>
      <p class="page-lead">${t('lifecyclePage.lead')}</p>
    </header>

    <article class="lifecycle-cycle">
      <header class="lifecycle-cycle-head">
        <div>
          <Badge :text=${translate('lifecyclePage.cycle.badge')} />
          <h2 class="lifecycle-cycle-title">${t('lifecyclePage.cycle.title')}</h2>
          <p class="lifecycle-cycle-lead">${t('lifecyclePage.cycle.lead')}</p>
        </div>
        <button type="button" class="btn btn-ghost" on-click=${() => showCode(translate('lifecyclePage.cycle.codeTitle'), cycleFlowCode)}>${t('shell.viewCode')}</button>
      </header>

      <div class="lifecycle-orbit" aria-label=${translate('lifecyclePage.cycle.diagramAria')}>
        <svg class="lifecycle-orbit-svg" viewBox="0 0 360 360" aria-hidden="true">
          <defs>
            <marker id="cycle-arrow-enter" markerWidth="8" markerHeight="8" refX="6" refY="4" orient="auto">
              <path d="M0,0 L8,4 L0,8 Z" fill="var(--leaf)" />
            </marker>
            <marker id="cycle-arrow-leave" markerWidth="8" markerHeight="8" refX="6" refY="4" orient="auto">
              <path d="M0,0 L8,4 L0,8 Z" fill="var(--warn)" />
            </marker>
          </defs>
          <circle class="lifecycle-orbit-ring" cx="180" cy="180" r="128" />
          <path class="lifecycle-orbit-path lifecycle-orbit-path--enter" d="M180 52 A128 128 0 0 1 308 180" marker-end="url(#cycle-arrow-enter)" />
          <path class="lifecycle-orbit-path lifecycle-orbit-path--enter" d="M308 180 A128 128 0 0 1 180 308" marker-end="url(#cycle-arrow-enter)" />
          <path class="lifecycle-orbit-path lifecycle-orbit-path--leave" d="M180 308 A128 128 0 0 1 52 180" marker-end="url(#cycle-arrow-leave)" />
          <path class="lifecycle-orbit-path lifecycle-orbit-path--leave" d="M52 180 A128 128 0 0 1 180 52" marker-end="url(#cycle-arrow-leave)" />
        </svg>

        <div class="lifecycle-orbit-layout">
          <div class="lifecycle-orbit-center">
            <span class="lifecycle-orbit-phase">${phaseLabel}</span>
            <span class="lifecycle-orbit-timer">${ticks}${t('lifecyclePage.orbit.timerSuffix')}</span>
            <span class="muted">${t('lifecyclePage.orbit.note')}</span>
          </div>

          <div class="lifecycle-orbit-node lifecycle-orbit-node--activate">
            <span class="lifecycle-orbit-step">${t('lifecyclePage.orbit.activate.step')}</span>
            <code>onActivate</code>
            <p>${t('lifecyclePage.orbit.activate.desc')}</p>
            <strong class="lifecycle-orbit-count">${activations}</strong>
          </div>

          <div class="lifecycle-orbit-node lifecycle-orbit-node--mount">
            <span class="lifecycle-orbit-step">${t('lifecyclePage.orbit.mount.step')}</span>
            <code>onMount</code>
            <p>${t('lifecyclePage.orbit.mount.desc')}</p>
            <strong class="lifecycle-orbit-count">${ticks}</strong>
          </div>

          <div class="lifecycle-orbit-node lifecycle-orbit-node--deactivate">
            <span class="lifecycle-orbit-step">${t('lifecyclePage.orbit.deactivate.step')}</span>
            <code>onDeactivate</code>
            <p>${t('lifecyclePage.orbit.deactivate.desc')}</p>
            <strong class="lifecycle-orbit-count">${deactivations}</strong>
          </div>

          <div class="lifecycle-orbit-node lifecycle-orbit-node--unmount">
            <span class="lifecycle-orbit-step">${t('lifecyclePage.orbit.unmount.step')}</span>
            <code>onUnmount</code>
            <p>${t('lifecyclePage.orbit.unmount.desc')}</p>
            <strong class="lifecycle-orbit-count">${unmounts}</strong>
          </div>
        </div>
      </div>

      <div class="lifecycle-orbit-legend">
        <span class="lifecycle-legend lifecycle-legend--enter">${t('lifecyclePage.legend.enter')}</span>
        <span class="lifecycle-legend lifecycle-legend--leave">${t('lifecyclePage.legend.leave')}</span>
      </div>

      <div class="lifecycle-orbit-actions">
        <p class="muted">${t('lifecyclePage.actions')}</p>
        <div class="row">
          #for quickLinks as link (link.path)
            <a class="btn btn-outline" jacare-go=${link.path} href=${appHref(link.path)}>${lessonTitle(link.id)}</a>
          #end
        </div>
      </div>
    </article>

    <Tip :text=${translate('lifecyclePage.tip')} />

    <div class="lesson-grid">
      <Demo :title=${translate('lifecyclePage.demo.title.title')} :lead=${translate('lifecyclePage.demo.title.lead')} :code=${titleCode}>
        <p class="muted">${t('lifecyclePage.demo.title.note')}</p>
      </Demo>

      <Demo :title=${translate('lifecyclePage.demo.hooks.title')} :lead=${translate('lifecyclePage.demo.hooks.lead')} :code=${hooksCode}>
        <div class="nav-live">
          <div class="nav-live-row"><span>${t('lifecyclePage.phaseLabel')}</span><code>${phaseLabel}</code></div>
          <div class="nav-live-row"><span>onActivate</span><code>${activations}</code></div>
          <div class="nav-live-row"><span>onDeactivate</span><code>${deactivations}</code></div>
          <div class="nav-live-row"><span>onUnmount</span><code>${unmounts}</code></div>
        </div>
      </Demo>

      <Demo :title=${translate('lifecyclePage.demo.scope.title')} :lead=${translate('lifecyclePage.demo.scope.lead')} :code=${scopeCode}>
        <p class="muted">${t('lifecyclePage.demo.scope.note')}</p>
      </Demo>

      <Demo :title=${translate('lifecyclePage.demo.activation.title')} :lead=${translate('lifecyclePage.demo.activation.lead')} :code=${activationCode}>
        <p class="metric">${activations}</p>
      </Demo>

      <Demo :title=${translate('lifecyclePage.demo.dispose.title')} :lead=${translate('lifecyclePage.demo.dispose.lead')} :code=${disposeCode}>
        <div class="stack">
          <button type="button" class="btn" on-click=${toggleBlock}>${blockToggleLabel}</button>
          <p class="muted">${t('lifecyclePage.demo.dispose.mounts')}: ${mounts} · ${t('lifecyclePage.demo.dispose.disposals')}: ${disposals}</p>
          #if showBlock()
            <p class="muted">${t('lifecyclePage.demo.dispose.mounted')}</p>
          #end
        </div>
      </Demo>
    </div>
  </section>
</view>
