import { pulse, derive } from '@jacare/core'
import Tip from '../components/Tip.jcr'
import Demo from '../components/Demo.jcr'
import { t, translate } from '../i18n.js'
import {
  clickCode,
  forCode,
  keydownCode,
  inputChangeCode,
  focusBlurCode,
  submitCode,
  padCode,
  stopCode,
  preventLinkCode,
  hoverCode,
  dblClickCode,
  debugEventsCode,
} from '../snippets/events.js'

const clicks = pulse(0)

function handleClick() {
  clicks.update((n) => n + 1)
}

const fruits = pulse([
  { id: 'apple', picks: 0 },
  { id: 'banana', picks: 0 },
  { id: 'cherry', picks: 0 },
])

function pick(id) {
  fruits.update((list) =>
    list.map((fruit) => (fruit.id === id ? { ...fruit, picks: fruit.picks + 1 } : fruit)),
  )
}

const searchDraft = pulse('')
const submittedSearch = pulse('')

function onSearchKeydown(event) {
  if (event.key === 'Enter') submittedSearch.set(searchDraft())
}

const note = pulse('')
const noteLive = pulse('')
const noteCommitted = pulse('')

function onNoteInput(event) {
  noteLive.set(event.target.value)
}

function onNoteChange(event) {
  noteCommitted.set(event.target.value)
}

const focused = pulse(false)
const focusLabel = derive(() =>
  focused() ? translate('events.demo.focus.focused') : translate('events.demo.focus.blurred'),
)
const focusLog = pulse([])
const focusLogText = derive(
  () => focusLog().join(' · ') || translate('events.demo.focus.empty'),
)

function onFocus() {
  focused.set(true)
  focusLog.update((lines) => [...lines.slice(-3), 'focus'])
}

function onBlur() {
  focused.set(false)
  focusLog.update((lines) => [...lines.slice(-3), 'blur'])
}

const formName = pulse('')
const formResult = pulse({ key: 'events.demo.submit.waiting' })
const formMsg = derive(() => translate(formResult().key, formResult().params))

function onFormSubmit(event) {
  event.preventDefault()
  const name = formName().trim()
  formResult.set(
    name
      ? { key: 'events.demo.submit.saved', params: { name } }
      : { key: 'events.demo.submit.required' },
  )
}

const padX = pulse(50)
const padY = pulse(50)
const padXPct = derive(() => padX() + '%')
const padYPct = derive(() => padY() + '%')
const pointerDown = pulse(false)
const pointerLabel = derive(() =>
  pointerDown() ? translate('events.demo.pad.pressing') : translate('events.demo.pad.idle'),
)

function onPadMove(event) {
  const rect = event.currentTarget.getBoundingClientRect()
  const x = ((event.clientX - rect.left) / rect.width) * 100
  const y = ((event.clientY - rect.top) / rect.height) * 100
  padX.set(Math.max(0, Math.min(100, Math.round(x))))
  padY.set(Math.max(0, Math.min(100, Math.round(y))))
}

function onPadDown() {
  pointerDown.set(true)
}

function onPadUp() {
  pointerDown.set(false)
}

const outerClicks = pulse(0)
const innerClicks = pulse(0)

function onOuterClick() {
  outerClicks.update((n) => n + 1)
}

function onInnerClick(event) {
  event.stopPropagation()
  innerClicks.update((n) => n + 1)
}

const linkBlocked = pulse(0)

function onLinkClick(event) {
  event.preventDefault()
  linkBlocked.update((n) => n + 1)
}

const hovering = pulse(false)
const hovers = pulse(0)
const hoverHint = derive(() =>
  translate('events.demo.hover.hint', {
    state: hovering() ? translate('events.demo.hover.yes') : translate('events.demo.hover.no'),
  }),
)

function onCardEnter() {
  hovering.set(true)
  hovers.update((n) => n + 1)
}

function onCardLeave() {
  hovering.set(false)
}

const doubles = pulse(0)

function onDoubleClick() {
  doubles.update((n) => n + 1)
}

export <view>
  <section class="page">
    <header class="page-hero">
      <p class="page-kicker">${t('events.kicker')}</p>
      <h1 class="page-title">${t('events.title')}</h1>
      <p class="page-lead">${t('events.lead')}</p>
    </header>

    <Tip :text=${t('events.tip')} />

    <div class="lesson-grid">
      <Demo :title=${t('events.demo.click.title')} :lead=${t('events.demo.click.lead')} :code=${clickCode}>
        <div class="stack">
          <div class="row">
            <button type="button" class="btn" on-click=${handleClick}>${t('events.demo.click.named')}</button>
            <button type="button" class="btn btn-outline" @click=${() => clicks.update((n) => n + 1)}>${t('events.demo.click.inline')}</button>
          </div>
          <p class="muted">${t('events.demo.click.clicks')}: ${clicks}</p>
        </div>
      </Demo>

      <Demo :title=${t('events.demo.loop.title')} :lead=${t('events.demo.loop.lead')} :code=${forCode}>
        <ul class="list">
          #for fruits() as fruit (fruit.id)
            <li class="list-item">
              <span class="item-label">${t('events.demo.loop.fruits.' + fruit.id)} · ${fruit.picks}</span>
              <button type="button" class="btn btn-outline" on-click=${() => pick(fruit.id)}>${t('events.demo.loop.pick')}</button>
            </li>
          #end
        </ul>
      </Demo>

      <Demo :title=${t('events.demo.keydown.title')} :lead=${t('events.demo.keydown.lead')} :code=${keydownCode}>
        <div class="stack">
          <input class="input" bind-value=${searchDraft} :placeholder=${translate('events.demo.keydown.placeholder')} on-keydown=${onSearchKeydown} />
          <p class="muted">${t('events.demo.keydown.submitted')}: ${submittedSearch}</p>
        </div>
      </Demo>

      <Demo :title=${t('events.demo.inputChange.title')} :lead=${t('events.demo.inputChange.lead')} :code=${inputChangeCode}>
        <div class="stack">
          <input
            class="input"
            bind-value=${note}
            :placeholder=${translate('events.demo.inputChange.placeholder')}
            on-input=${onNoteInput}
            on-change=${onNoteChange}
          />
          <p class="muted">${t('events.demo.inputChange.live')}: ${noteLive}</p>
          <p class="muted">${t('events.demo.inputChange.committed')}: ${noteCommitted}</p>
        </div>
      </Demo>

      <Demo :title=${t('events.demo.focus.title')} :lead=${t('events.demo.focus.lead')} :code=${focusBlurCode}>
        <div class="stack">
          <input class="input" :placeholder=${translate('events.demo.focus.placeholder')} on-focus=${onFocus} on-blur=${onBlur} />
          <p class="muted">${t('events.demo.focus.state')}: ${focusLabel}</p>
          <p class="muted">${t('events.demo.focus.log')}: ${focusLogText}</p>
        </div>
      </Demo>

      <Demo :title=${t('events.demo.submit.title')} :lead=${t('events.demo.submit.lead')} :code=${submitCode}>
        <form class="stack" on-submit=${onFormSubmit}>
          <input class="input" bind-value=${formName} :placeholder=${translate('events.demo.submit.placeholder')} />
          <button type="submit" class="btn">${t('events.demo.submit.submit')}</button>
          <p class="muted">${formMsg}</p>
        </form>
      </Demo>

      <Demo :title=${t('events.demo.pad.title')} :lead=${t('events.demo.pad.lead')} :code=${padCode}>
        <div class="stack">
          <div
            class="pad"
            style---x=${padXPct}
            style---y=${padYPct}
            on-pointermove=${onPadMove}
            on-pointerdown=${onPadDown}
            on-pointerup=${onPadUp}
            on-pointerleave=${onPadUp}
          ></div>
          <p class="muted">x: ${padX} · y: ${padY} · ${pointerLabel}</p>
        </div>
      </Demo>

      <Demo :title=${t('events.demo.stop.title')} :lead=${t('events.demo.stop.lead')} :code=${stopCode}>
        <div class="stack">
          <article class="card" on-click=${onOuterClick}>
            <p class="muted">${t('events.demo.stop.cardHint')}</p>
            <button type="button" class="btn" on-click=${onInnerClick}>${t('events.demo.stop.inner')}</button>
          </article>
          <p class="muted">${t('events.demo.stop.outerCount')}: ${outerClicks} · ${t('events.demo.stop.innerCount')}: ${innerClicks}</p>
        </div>
      </Demo>

      <Demo :title=${t('events.demo.preventLink.title')} :lead=${t('events.demo.preventLink.lead')} :code=${preventLinkCode}>
        <div class="stack">
          <a class="btn btn-outline" href="https://example.com" on-click=${onLinkClick}>
            ${t('events.demo.preventLink.link')}
          </a>
          <p class="muted">${t('events.demo.preventLink.calls')}: ${linkBlocked}</p>
        </div>
      </Demo>

      <Demo :title=${t('events.demo.hover.title')} :lead=${t('events.demo.hover.lead')} :code=${hoverCode}>
        <div class="stack">
          <article class="card" on-mouseenter=${onCardEnter} on-mouseleave=${onCardLeave}>
            <p class="muted">${hoverHint}</p>
          </article>
          <p class="muted">${t('events.demo.hover.entered')}: ${hovers}</p>
        </div>
      </Demo>

      <Demo :title=${t('events.demo.dblclick.title')} :lead=${t('events.demo.dblclick.lead')} :code=${dblClickCode}>
        <div class="stack">
          <button type="button" class="btn" on-dblclick=${onDoubleClick}>${t('events.demo.dblclick.button')}</button>
          <p class="muted">${t('events.demo.dblclick.count')}: ${doubles}</p>
        </div>
      </Demo>

      <Demo :title=${t('events.demo.debug.title')} :lead=${t('events.demo.debug.lead')} :code=${debugEventsCode}>
        <div class="stack">
          <div class="row">
            <button type="button" class="btn" on-click=${handleClick}>${t('events.demo.debug.click')}</button>
            <button type="button" class="btn btn-outline" on-click=${() => pick('apple')}>${t('events.demo.debug.pickApple')}</button>
          </div>
          <p class="muted">${t('events.demo.click.clicks')}: ${clicks}</p>
          <debug copy label="events">${{ clicks, fruits, outerClicks, innerClicks }}</debug>
        </div>
      </Demo>
    </div>
  </section>
</view>
