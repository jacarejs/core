import { pulse, derive } from '@jacare/core'
import Tip from '../components/Tip.jcr'
import Demo from '../components/Demo.jcr'
import { t } from '../i18n.js'
import { keyedCode, indexCode, emptyPatternCode, catalogCode, filterCode, moveTopCode } from '../snippets/lists.js'

const nextId = pulse(4)
const items = pulse([
  { id: '1', label: 'Alpha' },
  { id: '2', label: 'Beta' },
  { id: '3', label: 'Gamma' },
])
const draft = pulse('')

function addItem() {
  const label = draft().trim()
  if (!label) return
  const id = String(nextId())
  nextId.update((n) => n + 1)
  items.update((list) => [...list, { id, label }])
  draft.set('')
}

function onDraftKeydown(event) {
  if (event.key === 'Enter') addItem()
}

function removeItem(id) {
  items.update((list) => list.filter((item) => item.id !== id))
}

function moveUp(id) {
  items.update((list) => {
    const index = list.findIndex((item) => item.id === id)
    if (index <= 0) return list
    const next = list.slice()
    const swap = next[index - 1]
    next[index - 1] = next[index]
    next[index] = swap
    return next
  })
}

function moveDown(id) {
  items.update((list) => {
    const index = list.findIndex((item) => item.id === id)
    if (index === -1 || index >= list.length - 1) return list
    const next = list.slice()
    const swap = next[index + 1]
    next[index + 1] = next[index]
    next[index] = swap
    return next
  })
}

const ranked = ['Reactivity', 'Templates', 'Bindings']

const bucket = pulse([])

function addToBucket() {
  bucket.update((list) => [...list, { id: String(Date.now()) + '-' + list.length, label: 'Item ' + (list.length + 1) }])
}

function clearBucket() {
  bucket.set([])
}

const catalog = [
  { id: 'mug', name: 'Jacaré Mug' },
  { id: 'tee', name: 'Logo T-Shirt' },
  { id: 'sticker', name: 'Sticker Pack' },
]

const onlyUnfinished = pulse(false)
const chores = pulse([
  { id: '1', label: 'Water the plants', done: true },
  { id: '2', label: 'Feed the fish', done: false },
  { id: '3', label: 'Sweep the porch', done: false },
])

const visibleChores = derive(() => (onlyUnfinished() ? chores().filter((chore) => !chore.done) : chores()))

function toggleChore(id) {
  chores.update((list) => list.map((chore) => (chore.id === id ? { ...chore, done: !chore.done } : chore)))
}

function toggleFilter() {
  onlyUnfinished.update((on) => !on)
}

const podium = pulse([
  { id: 'a', name: 'Ada' },
  { id: 'b', name: 'Grace' },
  { id: 'c', name: 'Alan' },
])

function moveToTop(id) {
  podium.update((list) => {
    const index = list.findIndex((entry) => entry.id === id)
    if (index <= 0) return list
    const next = list.slice()
    const [entry] = next.splice(index, 1)
    next.unshift(entry)
    return next
  })
}

export <view>
  <section class="page">
    <header class="page-hero">
      <p class="page-kicker">${t('lists.kicker')}</p>
      <h1 class="page-title">${t('lists.title')}</h1>
      <p class="page-lead">${t('lists.lead')}</p>
    </header>

    <Tip :text=${t('lists.tip')} />

    <div class="lesson-grid">
      <Demo :title=${t('lists.demo.keyed.title')} :lead=${t('lists.demo.keyed.lead')} :code=${keyedCode}>
        <div class="stack">
          <div class="row">
            <input class="input" bind-value=${draft} placeholder=${t('lists.demo.keyed.placeholder')} on-keydown=${onDraftKeydown} />
            <button type="button" class="btn" on-click=${addItem}>${t('lists.demo.keyed.add')}</button>
          </div>
          <ul class="list">
            #for items() as item (item.id)
              <li class="list-item">
                <span class="item-label">${item.label}</span>
                <div class="row">
                  <button type="button" class="btn btn-ghost" on-click=${() => moveUp(item.id)}>↑</button>
                  <button type="button" class="btn btn-ghost" on-click=${() => moveDown(item.id)}>↓</button>
                  <button type="button" class="btn btn-outline" on-click=${() => removeItem(item.id)}>${t('lists.demo.keyed.remove')}</button>
                </div>
              </li>
            #end
          </ul>
        </div>
      </Demo>

      <Demo :title=${t('lists.demo.index.title')} :lead=${t('lists.demo.index.lead')} :code=${indexCode}>
        <ol class="list">
          #for ranked as rank, index (rank)
            <li class="list-item"><span class="item-label">${index + 1}. ${rank}</span></li>
          #end
        </ol>
      </Demo>

      <Demo :title=${t('lists.demo.empty.title')} :lead=${t('lists.demo.empty.lead')} :code=${emptyPatternCode}>
        <div class="stack">
          <div class="row">
            <button type="button" class="btn" on-click=${addToBucket}>${t('lists.demo.empty.add')}</button>
            <button type="button" class="btn btn-outline" on-click=${clearBucket}>${t('lists.demo.empty.clear')}</button>
          </div>

          <div>
            <p class="muted">${t('lists.demo.empty.patternA')}</p>
            #if bucket().length === 0
              <p class="muted">${t('lists.demo.empty.bucketEmpty')}</p>
            #else
              <ul class="list">
                #for bucket() as item (item.id)
                  <li class="list-item"><span class="item-label">${item.label}</span></li>
                #end
              </ul>
            #end
          </div>

          <div>
            <p class="muted">${t('lists.demo.empty.patternB')}</p>
            #if bucket().length === 0
              <p class="muted">${t('lists.demo.empty.bucketEmpty')}</p>
            #end
            <ul class="list">
              #for bucket() as item (item.id)
                <li class="list-item"><span class="item-label">${item.label}</span></li>
              #end
            </ul>
          </div>
        </div>
      </Demo>

      <Demo :title=${t('lists.demo.catalog.title')} :lead=${t('lists.demo.catalog.lead')} :code=${catalogCode}>
        <ul class="list">
          #for catalog as product (product.id)
            <li class="list-item"><span class="item-label">${product.name}</span></li>
          #end
        </ul>
      </Demo>

      <Demo :title=${t('lists.demo.filter.title')} :lead=${t('lists.demo.filter.lead')} :code=${filterCode}>
        <div class="stack">
          <label class="row"><input type="checkbox" bind-checked=${onlyUnfinished} /> ${t('lists.demo.filter.onlyUnfinished')}</label>
          <ul class="list">
            #for visibleChores() as chore (chore.id)
              <li class="list-item" class-done=${chore.done} on-click=${() => toggleChore(chore.id)}>
                <span class="item-label">${chore.label}</span>
              </li>
            #end
          </ul>
        </div>
      </Demo>

      <Demo :title=${t('lists.demo.moveTop.title')} :lead=${t('lists.demo.moveTop.lead')} :code=${moveTopCode}>
        <ol class="list">
          #for podium() as entry (entry.id)
            <li class="list-item">
              <span class="item-label">${entry.name}</span>
              <button type="button" class="btn btn-outline" on-click=${() => moveToTop(entry.id)}>${t('lists.demo.moveTop.action')}</button>
            </li>
          #end
        </ol>
      </Demo>
    </div>
  </section>
</view>
