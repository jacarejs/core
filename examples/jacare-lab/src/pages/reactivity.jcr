import { signal, computed, effect, watch, batch, untrack, pulse, derive, ReactiveCycleError, enablePatience, disablePatience, flushSync, isPatienceEnabled } from '@jacare/core'
import Tip from '../components/Tip.jcr'
import Demo from '../components/Demo.jcr'
import { t, translate } from '../i18n.js'
import {
  signalCode,
  computedCode,
  effectCode,
  batchCode,
  patienceCode,
  untrackCode,
  cycleGuardCode,
  aliasCode,
  rangeCode,
  watchCode,
  nestedComputedCode,
} from '../snippets/reactivity.js'

const count = signal(0)
const peeked = signal(null)
const lastPeekText = derive(() => translate('reactivity.signal.lastPeek', { value: peeked() }))

function incrementCount() {
  count.update((n) => n + 1)
}

function resetCount() {
  count.set(0)
}

function peekCount() {
  peeked.set(count.peek)
}

const price = signal(12)
const qty = signal(3)
const total = computed(() => Number(price()) * Number(qty()))
const totalText = derive(() => translate('reactivity.computed.total', { value: total() }))

const log = signal([])
const ticker = signal(0)

effect(() => {
  const value = ticker()
  const line = untrack(() => translate('reactivity.effect.line', { value }))
  log.update((lines) => [...lines.slice(-4), line])
})

function bumpTicker() {
  ticker.update((n) => n + 1)
}

const logText = computed(() => log().join('\n'))

const batchA = signal(0)
const batchB = signal(0)
const batchRuns = signal(0)
const batchStatus = derive(() =>
  translate('reactivity.batch.status', { a: batchA(), b: batchB(), runs: batchRuns() }),
)

effect(() => {
  batchA()
  batchB()
  batchRuns.update((n) => n + 1)
})

function bumpSeparately() {
  batchA.update((n) => n + 1)
  batchB.update((n) => n + 1)
}

function bumpBatched() {
  batch(() => {
    batchA.update((n) => n + 1)
    batchB.update((n) => n + 1)
  })
}

const patienceA = signal(0)
const patienceB = signal(0)
const patienceRuns = signal(0)
const patienceOn = signal(false)
const patienceStatus = derive(() =>
  translate('reactivity.patience.status', {
    state: patienceOn()
      ? translate('reactivity.patience.on')
      : translate('reactivity.patience.off'),
    a: patienceA(),
    b: patienceB(),
    runs: patienceRuns(),
  }),
)

effect(() => {
  patienceA()
  patienceB()
  patienceRuns.update((n) => n + 1)
})

function togglePatience() {
  if (isPatienceEnabled()) {
    disablePatience()
    patienceOn.set(false)
  } else {
    enablePatience()
    patienceOn.set(true)
  }
}

function bumpPatienceBurst() {
  patienceA.update((n) => n + 1)
  patienceB.update((n) => n + 1)
}

function flushPatienceNow() {
  flushSync()
}

const tracked = signal(0)
const untrackedSource = signal(0)
const trackedRuns = signal(0)
const untrackStatus = derive(() =>
  translate('reactivity.untrack.status', {
    tracked: tracked(),
    untracked: untrackedSource(),
    runs: trackedRuns(),
  }),
)

effect(() => {
  tracked()
  untrack(() => untrackedSource())
  trackedRuns.update((n) => n + 1)
})

function bumpTracked() {
  tracked.update((n) => n + 1)
}

function bumpUntrackedSource() {
  untrackedSource.update((n) => n + 1)
}

const cycleStatus = signal(translate('reactivity.cycle.notRun'))
const settled = signal(0)
const settledText = derive(() => translate('reactivity.cycle.settledAt', { value: settled() }))

function triggerCycle() {
  const a = signal(0)
  const b = signal(0)
  try {
    effect(() => {
      a()
      b.set(b() + 1)
    })
    effect(() => {
      b()
      a.set(a() + 1)
    })
    a.set(1)
    cycleStatus.set(translate('reactivity.cycle.settledOk'))
  } catch (error) {
    cycleStatus.set(error instanceof ReactiveCycleError ? error.message : String(error))
  }
}

function triggerSettling() {
  const step = signal(0)
  effect(() => {
    if (step() < 3) step.set(step() + 1)
  })
  settled.set(step.peek)
}

const aliasCount = pulse(0)
const aliasDoubled = derive(() => aliasCount() * 2)
const aliasDoubledText = derive(() =>
  translate('reactivity.alias.doubled', { value: aliasDoubled() }),
)

function bumpAlias() {
  aliasCount.update((n) => n + 1)
}

const score = pulse(50)
const scoreCategory = derive(() => {
  const n = Number(score())
  if (n < 34) return translate('reactivity.range.low')
  if (n < 67) return translate('reactivity.range.medium')
  return translate('reactivity.range.high')
})

const temp = signal(20)
const effectLog = signal([])
const watchLog = signal([])

effect(() => {
  const value = temp()
  const line = untrack(() => translate('reactivity.watch.effectLine', { value }))
  effectLog.update((lines) => [...lines.slice(-3), line])
})

watch(() => {
  const value = temp()
  const line = untrack(() => translate('reactivity.watch.watchLine', { value }))
  watchLog.update((lines) => [...lines.slice(-3), line])
})

const effectLogText = computed(() => effectLog().join('\n'))
const watchLogText = computed(() => watchLog().join('\n'))

function bumpTemp(delta) {
  temp.update((n) => n + delta)
}

const meters = signal(2)
const centimeters = computed(() => meters() * 100)
const millimeters = computed(() => centimeters() * 10)
const unitsText = derive(() =>
  translate('reactivity.nested.units', {
    m: meters(),
    cm: centimeters(),
    mm: millimeters(),
  }),
)

export <view>
  <section class="page">
    <header class="page-hero">
      <p class="page-kicker">${t('reactivity.kicker')}</p>
      <h1 class="page-title">${t('reactivity.title')}</h1>
      <p class="page-lead">${t('reactivity.lead')}</p>
    </header>

    <Tip :text=${t('reactivity.tip1')} />
    <Tip :text=${t('reactivity.tip2')} />

    <div class="lesson-grid">
      <Demo :title=${t('reactivity.signal.title')} :lead=${t('reactivity.signal.lead')} :code=${signalCode}>
        <div class="stack">
          <div class="row">
            <span class="metric">${count}</span>
            <button type="button" class="btn" on-click=${incrementCount}>+1</button>
            <button type="button" class="btn btn-outline" on-click=${resetCount}>${t('reactivity.signal.reset')}</button>
            <button type="button" class="btn btn-ghost" on-click=${peekCount}>${t('reactivity.signal.peek')}</button>
          </div>
          #if peeked() !== null
            <p class="muted">${lastPeekText}</p>
          #end
        </div>
      </Demo>

      <Demo :title=${t('reactivity.computed.title')} :lead=${t('reactivity.computed.lead')} :code=${computedCode}>
        <div class="stack">
          <div class="row">
            <label class="field">
              <span class="field-label">${t('reactivity.computed.price')}</span>
              <input class="input" type="number" min="0" bind-value=${price} />
            </label>
            <label class="field">
              <span class="field-label">${t('reactivity.computed.qty')}</span>
              <input class="input" type="number" min="0" bind-value=${qty} />
            </label>
          </div>
          <p class="metric">${totalText}</p>
        </div>
      </Demo>

      <Demo :title=${t('reactivity.effect.title')} :lead=${t('reactivity.effect.lead')} :code=${effectCode}>
        <div class="stack">
          <button type="button" class="btn" on-click=${bumpTicker}>${t('reactivity.effect.bump')}</button>
          <pre class="log">${logText}</pre>
        </div>
      </Demo>

      <Demo :title=${t('reactivity.batch.title')} :lead=${t('reactivity.batch.lead')} :code=${batchCode}>
        <div class="stack">
          <div class="row">
            <button type="button" class="btn btn-outline" on-click=${bumpSeparately}>${t('reactivity.batch.separately')}</button>
            <button type="button" class="btn" on-click=${bumpBatched}>${t('reactivity.batch.batched')}</button>
          </div>
          <p class="muted">${batchStatus}</p>
        </div>
      </Demo>

      <Demo :title=${t('reactivity.patience.title')} :lead=${t('reactivity.patience.lead')} :code=${patienceCode}>
        <div class="stack">
          <div class="row">
            <button type="button" class="btn" on-click=${togglePatience}>${t('reactivity.patience.toggle')}</button>
            <button type="button" class="btn btn-outline" on-click=${bumpPatienceBurst}>${t('reactivity.patience.burst')}</button>
            <button type="button" class="btn btn-ghost" on-click=${flushPatienceNow}>flushSync()</button>
          </div>
          <p class="muted">${patienceStatus}</p>
        </div>
      </Demo>

      <Demo :title=${t('reactivity.untrack.title')} :lead=${t('reactivity.untrack.lead')} :code=${untrackCode}>
        <div class="stack">
          <div class="row">
            <button type="button" class="btn" on-click=${bumpTracked}>${t('reactivity.untrack.bumpTracked')}</button>
            <button type="button" class="btn btn-outline" on-click=${bumpUntrackedSource}>${t('reactivity.untrack.bumpUntracked')}</button>
          </div>
          <p class="muted">${untrackStatus}</p>
        </div>
      </Demo>

      <Demo :title=${t('reactivity.cycle.title')} :lead=${t('reactivity.cycle.lead')} :code=${cycleGuardCode}>
        <div class="stack">
          <div class="row">
            <button type="button" class="btn" on-click=${triggerCycle}>${t('reactivity.cycle.run')}</button>
            <button type="button" class="btn btn-outline" on-click=${triggerSettling}>${t('reactivity.cycle.settle')}</button>
          </div>
          <pre class="log">${cycleStatus}</pre>
          <p class="muted">${settledText}</p>
        </div>
      </Demo>

      <Demo :title=${t('reactivity.alias.title')} :lead=${t('reactivity.alias.lead')} :code=${aliasCode}>
        <div class="stack">
          <div class="row">
            <span class="metric">${aliasCount}</span>
            <button type="button" class="btn" on-click=${bumpAlias}>+1</button>
          </div>
          <p class="muted">${aliasDoubledText}</p>
        </div>
      </Demo>

      <Demo :title=${t('reactivity.range.title')} :lead=${t('reactivity.range.lead')} :code=${rangeCode}>
        <div class="stack">
          <input class="input" type="range" min="0" max="100" bind-value=${score} />
          <p class="metric">${score} → ${scoreCategory}</p>
        </div>
      </Demo>

      <Demo :title=${t('reactivity.watch.title')} :lead=${t('reactivity.watch.lead')} :code=${watchCode}>
        <div class="stack">
          <div class="row">
            <button type="button" class="btn btn-outline" on-click=${() => bumpTemp(-1)}>−1°C</button>
            <span class="metric">${temp}°C</span>
            <button type="button" class="btn" on-click=${() => bumpTemp(1)}>+1°C</button>
          </div>
          <pre class="log">${effectLogText}</pre>
          <pre class="log">${watchLogText}</pre>
        </div>
      </Demo>

      <Demo :title=${t('reactivity.nested.title')} :lead=${t('reactivity.nested.lead')} :code=${nestedComputedCode}>
        <div class="stack">
          <input class="input" type="number" min="0" step="0.1" bind-value=${meters} />
          <p class="muted">${unitsText}</p>
        </div>
      </Demo>
    </div>
  </section>
</view>
