import '../bags/mesh30.js'
import Tip from '../components/Tip.jcr'
import { appHref } from '../app-base.js'
import { t } from '../i18n.js'

export <view>
  <section class="page page-mesh30-checkout">
    <header class="page-hero">
      <p class="page-kicker">${t('bagCheckout.kicker')}</p>
      <h1 class="page-title">${t('bagCheckout.title')}</h1>
      <p class="page-lead">
        ${t('bagCheckout.leadStart')}
        <a jacare-go="/bag" href=${appHref('/bag')}>${t('bag.title')}</a>${t('bagCheckout.leadEnd')}
      </p>
    </header>

    <Tip :text=${t('bagCheckout.tip')} />

    <div class="mesh30-checkout-card">
      <p class="mesh30-badge mesh30-badge-lg">
        ${t('bagCheckout.sharedBadge')} · <strong>${@lab-mesh30/count}</strong>
      </p>
      <div class="row">
        <button type="button" class="btn btn-ghost" on-click=${@lab-mesh30/clear}>${t('bagCheckout.clear')}</button>
        <a class="btn" jacare-go="/bag" href=${appHref('/bag')}>${t('bagCheckout.back')}</a>
      </div>
    </div>
  </section>
</view>
