import Tip from '../components/Tip.jcr'
import Demo from '../components/Demo.jcr'
import { appHref } from '../app-base.js'
import { t } from '../i18n.js'
import { lessonTitle } from '../topics.js'
import {
  bindingIrCode,
  checkBindingsCode,
  compileApiCode,
  expressionStyleCode,
  testingCode,
} from '../snippets/tooling.js'

const pipelineRows = [
  { step: '1', title: 'Parse', detail: 'parseModule + parseTemplate → AST' },
  { step: '2', title: 'Lower', detail: 'Binding IR sites + MountPlan forest' },
  { step: '3', title: 'Emit', detail: 'mount() · render() · CPW · jacare check' },
]

const siteRows = [
  { kind: 'text', helper: 'bindText', noteKey: 'bindingIr.sites.notes.text' },
  { kind: 'attr', helper: 'bindAttribute', noteKey: 'bindingIr.sites.notes.attr' },
  { kind: 'class', helper: 'bindClass', noteKey: 'bindingIr.sites.notes.class' },
  { kind: 'styleVar', helper: 'bindStyleVar', noteKey: 'bindingIr.sites.notes.styleVar' },
  { kind: 'model', helper: 'bindModel', noteKey: 'bindingIr.sites.notes.model' },
  { kind: 'if', helper: 'branch', noteKey: 'bindingIr.sites.notes.if' },
  { kind: 'list', helper: 'reconcileKeyedList', noteKey: 'bindingIr.sites.notes.list' },
  { kind: 'mesh', helper: 'Mesh Port', noteKey: 'bindingIr.sites.notes.mesh' },
]

export <view>
  <section class="page">
    <header class="page-hero">
      <p class="page-kicker">${t('bindingIr.kicker')}</p>
      <h1 class="page-title">${t('bindingIr.title')}</h1>
      <p class="page-lead">
        ${t('bindingIr.leadPre')}
        <code>jacare check --bindings</code>
        ${t('bindingIr.leadPost')}
      </p>
      <div class="row" style="margin-top:0.75rem;flex-wrap:wrap;gap:0.5rem">
        <a class="btn btn-primary" jacare-go="/bindings" href=${appHref('/bindings')}>${t('bindingIr.links.bindings')}</a>
        <a class="btn btn-outline" jacare-go="/tooling" href=${appHref('/tooling')}>${lessonTitle('tooling')}</a>
        <a class="btn btn-outline" jacare-go="/playground" href=${appHref('/playground')}>${lessonTitle('playground')}</a>
      </div>
    </header>

    <Tip :text=${t('bindingIr.tip')} />

    <div class="lesson-grid">
      <Demo :title=${t('bindingIr.pipeline.title')} :lead=${t('bindingIr.pipeline.lead')} :code=${bindingIrCode}>
        <div class="nav-live">
          #for pipelineRows as row (row.step)
            <div class="nav-live-row">
              <code>${row.step}. ${row.title}</code>
              <span>${row.detail}</span>
            </div>
          #end
        </div>
      </Demo>

      <Demo :title=${t('bindingIr.sites.title')} :lead=${t('bindingIr.sites.lead')} :code=${checkBindingsCode}>
        <div class="nav-live">
          #for siteRows as row (row.kind)
            <div class="nav-live-row">
              <code>${row.kind} → ${row.helper}</code>
              <span>${t(row.noteKey)}</span>
            </div>
          #end
        </div>
      </Demo>

      <div class="ref-card">
        <h3>${t('bindingIr.check.title')}</h3>
        <p class="muted">${t('bindingIr.check.body')}</p>
        <pre><code>${checkBindingsCode}</code></pre>
      </div>

      <div class="ref-card">
        <h3>${t('bindingIr.inspect.title')}</h3>
        <p class="muted">${t('bindingIr.inspect.body')}</p>
        <pre><code>${bindingIrCode}</code></pre>
      </div>

      <div class="ref-card">
        <h3>${t('bindingIr.expression.title')}</h3>
        <p class="muted">${t('bindingIr.expression.body')}</p>
        <pre><code>${expressionStyleCode}</code></pre>
      </div>

      <div class="ref-card">
        <h3>${t('bindingIr.compileApi.title')}</h3>
        <p class="muted">${t('bindingIr.compileApi.body')}</p>
        <pre><code>${compileApiCode}</code></pre>
      </div>

      <div class="ref-card">
        <h3>${t('bindingIr.testing.title')}</h3>
        <p class="muted">${t('bindingIr.testing.body')}</p>
        <pre><code>${testingCode}</code></pre>
      </div>
    </div>
  </section>
</view>
