import { pulse, derive } from '@jacare/core'
import { t, translate } from '../i18n.js'
import Tip from '../components/Tip.jcr'
import Demo from '../components/Demo.jcr'
import { assetUrl, appHref } from '../app-base.js'
import {
  cliCode,
  vitePluginCode,
  compileApiCode,
  checkBindingsCode,
  checkRoutesCode,
  expressionStyleCode,
  bindingIrCode,
  devtoolsCode,
  testingCode,
  scriptsCode,
  namedPulsesCode,
} from '../snippets/tooling.js'

const marketplaceUrl = 'https://marketplace.visualstudio.com/items?itemName=heberalmeida.jacare'
const marketplaceImg = assetUrl('vscode-marketplace.png')

const count = pulse(0)
const doubled = derive(() => count() * 2)

function bump() {
  count.update((n) => n + 1)
}

export <view>
  <section class="page">
    <header class="page-hero">
      <p class="page-kicker">${t('toolingPage.kicker')}</p>
      <h1 class="page-title">${t('toolingPage.title')}</h1>
      <p class="page-lead">${t('toolingPage.lead')}</p>
    </header>

    <Tip :text=${translate('toolingPage.tip')} />

    <div class="lesson-grid">
      <Demo :title=${translate('toolingPage.demo.named.title')} :lead=${translate('toolingPage.demo.named.lead')} :code=${namedPulsesCode}>
        <div class="stack">
          <div class="row">
            <button type="button" class="btn" on-click=${bump}>count++</button>
            <p class="muted">count ${count} · doubled ${doubled}</p>
          </div>
        </div>
      </Demo>

      <a class="vscode-card" href=${marketplaceUrl} target="_blank" rel="noopener noreferrer">
        <img
          class="vscode-card-img"
          src=${marketplaceImg}
          width="360"
          height="123"
          alt=${translate('toolingPage.vscode.alt')}
        />
        <div class="vscode-card-copy">
          <strong>${t('toolingPage.vscode.title')}</strong>
          <span>${t('toolingPage.vscode.body')}</span>
          <span class="vscode-card-link">marketplace.visualstudio.com/items?itemName=heberalmeida.jacare</span>
        </div>
      </a>

      <article class="ref-card">
        <h3>${t('toolingPage.uiKit.title')}</h3>
        <p class="muted">${t('toolingPage.uiKit.body')}</p>
        <p class="muted">
          <a
            class="text-link"
            href="https://jacarejs.github.io/ui/"
            target="_blank"
            rel="noopener noreferrer"
          >${t('toolingPage.uiKit.link')}</a>
          <span aria-hidden="true"> · </span>
          <a class="text-link" jacare-go="/ui" href=${appHref('/ui')}>/ui</a>
          <span aria-hidden="true"> · </span>
          <a class="text-link" jacare-go="/i18n" href=${appHref('/i18n')}>/i18n</a>
        </p>
      </article>

      <div class="ref-card">
        <h3>${t('toolingPage.typescript.title')}</h3>
        <p class="muted">
          ${t('toolingPage.typescript.body1')} <code>*.jcr.ts</code>, <code>// @jacare-ts</code>,
          ${t('toolingPage.typescript.body2')} <code>.ts</code>
          ${t('toolingPage.typescript.body3')}
          <a class="text-link" jacare-go="/typescript" href=${appHref('/typescript')}>/typescript</a>.
        </p>
      </div>

      <Demo :title=${translate('toolingPage.demo.cli.title')} :lead=${translate('toolingPage.demo.cli.lead')} :code=${cliCode}>
        <pre class="log">${cliCode}</pre>
      </Demo>

      <div class="ref-card">
        <h3>${t('toolingPage.card.checkBindings.title')}</h3>
        <p class="muted">${t('toolingPage.card.checkBindings.body')}</p>
        <pre><code>${checkBindingsCode}</code></pre>
      </div>

      <div class="ref-card">
        <h3>${t('toolingPage.card.checkRoutes.title')}</h3>
        <p class="muted">${t('toolingPage.card.checkRoutes.body')}</p>
        <pre><code>${checkRoutesCode}</code></pre>
      </div>

      <div class="ref-card">
        <h3>${t('toolingPage.card.expression.title')}</h3>
        <p class="muted">${t('toolingPage.card.expression.body')}</p>
        <pre><code>${expressionStyleCode}</code></pre>
      </div>

      <div class="ref-card">
        <h3>${t('toolingPage.card.bindingIr.title')}</h3>
        <p class="muted">
          ${t('toolingPage.card.bindingIr.body1')}
          ${t('toolingPage.card.bindingIr.body2')}
          <a class="text-link" jacare-go="/binding-ir" href=${appHref('/binding-ir')}>/binding-ir</a>.
        </p>
        <pre><code>${bindingIrCode}</code></pre>
      </div>

      <div class="ref-card">
        <h3>${t('toolingPage.card.vite.title')}</h3>
        <p class="muted">${t('toolingPage.card.vite.body')}</p>
        <pre><code>${vitePluginCode}</code></pre>
      </div>

      <div class="ref-card">
        <h3>${t('toolingPage.card.compiler.title')}</h3>
        <p class="muted">${t('toolingPage.card.compiler.body')}</p>
        <pre><code>${compileApiCode}</code></pre>
      </div>

      <div class="ref-card">
        <h3>${t('toolingPage.card.devtools.title')}</h3>
        <p class="muted">${t('toolingPage.card.devtools.body')}</p>
        <pre><code>${devtoolsCode}</code></pre>
      </div>

      <div class="ref-card">
        <h3>${t('toolingPage.card.testing.title')}</h3>
        <p class="muted">${t('toolingPage.card.testing.body')}</p>
        <pre><code>${testingCode}</code></pre>
      </div>

      <div class="ref-card">
        <h3>${t('toolingPage.card.scripts.title')}</h3>
        <p class="muted">${t('toolingPage.card.scripts.body')}</p>
        <pre><code>${scriptsCode}</code></pre>
      </div>
    </div>
  </section>
</view>
