import { pulse, derive } from '@jacare/core'
import Tip from '../components/Tip.jcr'
import Demo from '../components/Demo.jcr'
import { appHref } from '../app-base.js'
import { t, translate } from '../i18n.js'
import { lessonTitle } from '../topics.js'
import {
  reservedBlocksCode,
  reservedDirectivesCode,
  allBindsCode,
  bindsWithIfCode,
  contractBindCode,
  cliCreateRunBuildCode,
} from '../snippets/language.js'

const draft = pulse('')
const on = pulse(false)
const href = pulse('/helpers')
const busy = pulse(false)
const width = pulse(45)
const pct = derive(() => width() + '%')
const tab = pulse('a')

const show = pulse(true)
const email = pulse('')
const err = pulse('')
const okText = derive(() => translate('language.bindsIf.ok', { email: email() }))

const blockRows = [
  { token: 'export <' + 'view>', roleKey: 'language.blocks.roles.view' },
  { token: 'export <' + 'style>', roleKey: 'language.blocks.roles.style' },
  { token: 'export <' + 'contract>', roleKey: 'language.blocks.roles.contract' },
]

const directiveRows = [
  { token: '#if / #elif / #else / #end', roleKey: 'language.directives.roles.if' },
  { token: '#case / #when / #else', roleKey: 'language.directives.roles.case' },
  { token: '#for list as item (key)', roleKey: 'language.directives.roles.for' },
]

const prefixRows = [
  { token: 'on-* / @*', roleKey: 'language.prefixes.roles.events' },
  { token: 'bind-*', roleKey: 'language.prefixes.roles.bind' },
  { token: ':*', roleKey: 'language.prefixes.roles.prop' },
  { token: 'class-* / class:*', roleKey: 'language.prefixes.roles.class' },
  { token: 'style---* / style:*', roleKey: 'language.prefixes.roles.styleVar' },
  { token: '${@bag/key}', roleKey: 'language.prefixes.roles.mesh' },
  { token: '${@route/key}', roleKey: 'language.prefixes.roles.route' },
]

const specialRows = [
  { token: '<slot> / slot="name"', roleKey: 'language.special.roles.slot' },
  { token: '<debug>', roleKey: 'language.special.roles.debug' },
  { token: 'jacare-frame / jacare-go', roleKey: 'language.special.roles.frame' },
  { token: 'jacare-when={expr}', roleKey: 'language.special.roles.when' },
  { token: 'data-jacare-focus', roleKey: 'language.special.roles.focus' },
]

const cliRows = [
  { token: 'jacare new / create-jacare', roleKey: 'language.cli.roles.new' },
  { token: 'jacare dev', roleKey: 'language.cli.roles.dev' },
  { token: 'jacare build', roleKey: 'language.cli.roles.build' },
  { token: 'jacare check [--bindings]', roleKey: 'language.cli.roles.check' },
  { token: 'jacare check --routes', roleKey: 'language.cli.roles.routes' },
  { token: 'jacare compile', roleKey: 'language.cli.roles.compile' },
]

const runtimeRows = [
  { id: 'state', areaKey: 'language.runtime.areas.state', mechanism: 'signal / pulse · computed / derive' },
  {
    id: 'effects',
    areaKey: 'language.runtime.areas.effects',
    mechanism: 'effect / watch · batch · Patience (opt-in) · untrack',
  },
  {
    id: 'shared',
    areaKey: 'language.runtime.areas.shared',
    mechanism: 'createBag / getBag · ripple · snap / hydrate',
  },
  {
    id: 'text',
    areaKey: 'language.runtime.areas.text',
    mechanism: 'bindText · bindAttribute · bindClass · bindStyleVar',
  },
  {
    id: 'model',
    areaKey: 'language.runtime.areas.model',
    mechanism: 'bindModel (bind-value / bind-checked)',
  },
  {
    id: 'conditional',
    areaKey: 'language.runtime.areas.conditional',
    mechanism: 'branch / showIf (#if · jacare-when · #case)',
  },
  {
    id: 'list',
    areaKey: 'language.runtime.areas.list',
    mechanism: 'reconcileKeyedList (#for … (key))',
  },
  {
    id: 'app',
    areaKey: 'language.runtime.areas.app',
    mechanism: 'createNav · getRouteParam · createForm · createLifecycle',
  },
  {
    id: 'ssr',
    areaKey: 'language.runtime.areas.ssr',
    mechanism: 'renderToString · renderToStream · resumeBindings',
  },
  {
    id: 'devtools',
    areaKey: 'language.runtime.areas.devtools',
    mechanism: 'devtoolsBind · registerScope · Pulse / Mesh / Scope',
  },
  {
    id: 'compiler',
    areaKey: 'language.runtime.areas.compiler',
    mechanism: 'Binding IR · MountPlan · CPW · jacare check [--routes]',
  },
]

export <view>
  <section class="page">
    <header class="page-hero">
      <p class="page-kicker">${t('language.kicker')}</p>
      <h1 class="page-title">${t('language.title')}</h1>
      <p class="page-lead">
        ${t('language.lead1')}
        <code>docs/language-reference.md</code>
        ${t('language.leadAnd')}
        <code>docs/api.md</code>
        §2b · §5 · §17 · §20
        <a class="text-link" jacare-go="/helpers" href=${appHref('/helpers')}>${lessonTitle('helpers')}</a>.
        ${t('language.leadFeatured')}
        <a class="text-link" jacare-go="/binding-ir" href=${appHref('/binding-ir')}>${lessonTitle('binding-ir')}</a>.
      </p>
    </header>

    <Tip :text=${t('language.tip')} />

    <div class="lesson-grid">
      <Demo :title=${t('language.runtime.title')} :lead=${t('language.runtime.lead')} :code=${reservedBlocksCode}>
        <div class="nav-live">
          #for runtimeRows as row (row.id)
            <div class="nav-live-row">
              <code>${t(row.areaKey)}</code>
              <span>${row.mechanism}</span>
            </div>
          #end
        </div>
        <div class="row" style="margin-top:0.75rem;flex-wrap:wrap;gap:0.5rem">
          <a class="btn btn-outline" jacare-go="/reactivity" href=${appHref('/reactivity')}>${lessonTitle('reactivity')}</a>
          <a class="btn btn-outline" jacare-go="/bag" href=${appHref('/bag')}>${lessonTitle('bag')}</a>
          <a class="btn btn-outline" jacare-go="/binding-ir" href=${appHref('/binding-ir')}>${lessonTitle('binding-ir')}</a>
          <a class="btn btn-outline" jacare-go="/nav" href=${appHref('/nav')}>${lessonTitle('nav')}</a>
          <a class="btn btn-outline" jacare-go="/forms" href=${appHref('/forms')}>${lessonTitle('forms')}</a>
          <a class="btn btn-outline" jacare-go="/ssr" href=${appHref('/ssr')}>${lessonTitle('ssr')}</a>
          <a class="btn btn-outline" jacare-go="/island" href=${appHref('/island')}>${lessonTitle('island')}</a>
          <a class="btn btn-outline" jacare-go="/helpers" href=${appHref('/helpers')}>${t('language.links.imports')}</a>
        </div>
      </Demo>

      <Demo :title=${t('language.blocks.title')} :lead=${t('language.blocks.lead')} :code=${reservedBlocksCode}>
        <div class="nav-live">
          #for blockRows as row (row.token)
            <div class="nav-live-row">
              <code>${row.token}</code>
              <span>${t(row.roleKey)}</span>
            </div>
          #end
        </div>
      </Demo>

      <Demo :title=${t('language.directives.title')} :lead=${t('language.directives.lead')} :code=${reservedDirectivesCode}>
        <div class="nav-live">
          #for directiveRows as row (row.token)
            <div class="nav-live-row">
              <code>${row.token}</code>
              <span>${t(row.roleKey)}</span>
            </div>
          #end
        </div>
      </Demo>

      <Demo :title=${t('language.prefixes.title')} :lead=${t('language.prefixes.lead')} :code=${allBindsCode}>
        <div class="nav-live">
          #for prefixRows as row (row.token)
            <div class="nav-live-row">
              <code>${row.token}</code>
              <span>${t(row.roleKey)}</span>
            </div>
          #end
        </div>
      </Demo>

      <Demo :title=${t('language.bindsLive.title')} :lead=${t('language.bindsLive.lead')} :code=${allBindsCode}>
        <div class="stack">
          <input class="input" bind-value=${draft} placeholder="bind-value" />
          <label class="row"><input type="checkbox" bind-checked=${on} /> bind-checked</label>
          <a class="btn btn-outline" bind-href=${href}>bind-href → ${href}</a>
          <button type="button" class="btn" :disabled=${busy} on-click=${() => busy.update((v) => !v)}>
            :disabled (${busy})
          </button>
          <div class="row">
            <button type="button" class="btn btn-outline" class-active=${tab() === 'a'} on-click=${() => tab.set('a')}>A</button>
            <button type="button" class="btn btn-outline" class-active=${tab() === 'b'} on-click=${() => tab.set('b')}>B</button>
          </div>
          <div class="bar" style---pct=${pct}></div>
          <input class="input" type="range" min="0" max="100" bind-value=${width} />
          <p class="muted">draft=${draft} · on=${on} · pct=${pct}</p>
        </div>
      </Demo>

      <Demo :title=${t('language.bindsIf.title')} :lead=${t('language.bindsIf.lead')} :code=${bindsWithIfCode}>
        <div class="stack">
          <label class="row"><input type="checkbox" bind-checked=${show} /> ${t('language.bindsIf.showForm')}</label>
          #if show()
            <input class="input" bind-value=${email} placeholder=${t('language.bindsIf.emailPlaceholder')} />
            #if err()
              <p class="muted">${err}</p>
            #else
              <p class="muted">${okText}</p>
            #end
          #else
            <p class="muted">${t('language.bindsIf.hidden')}</p>
          #end
        </div>
      </Demo>

      <Demo :title=${t('language.contract.title')} :lead=${t('language.contract.lead')} :code=${contractBindCode}>
        <pre class="log">${contractBindCode}</pre>
      </Demo>

      <Demo :title=${t('language.special.title')} :lead=${t('language.special.lead')} :code=${reservedBlocksCode}>
        <div class="nav-live">
          #for specialRows as row (row.token)
            <div class="nav-live-row">
              <code>${row.token}</code>
              <span>${t(row.roleKey)}</span>
            </div>
          #end
        </div>
      </Demo>

      <Demo :title=${t('language.cli.title')} :lead=${t('language.cli.lead')} :code=${cliCreateRunBuildCode}>
        <div class="nav-live nav-live-cli">
          #for cliRows as row (row.token)
            <div class="nav-live-row">
              <code>${row.token}</code>
              <span>${t(row.roleKey)}</span>
            </div>
          #end
        </div>
        <pre class="log">${cliCreateRunBuildCode}</pre>
      </Demo>
    </div>
  </section>
</view>

export <style>
.bar {
  width: var(--pct);
  height: 8px;
  background: #189030;
  border-radius: 4px;
  transition: width 0.12s ease;
}
.btn-outline.active {
  outline: 2px solid #189030;
}
</style>
