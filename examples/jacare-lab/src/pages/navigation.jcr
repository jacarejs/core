import { routeHref, pulse, derive } from '@jacare/core'
import { appHref } from '../app-base.js'
import { nav, route } from '../nav.js'
import { showCode } from '../code-viewer.js'
import Tip from '../components/Tip.jcr'
import Demo from '../components/Demo.jcr'
import Badge from '../components/Badge.jcr'
import { t, translate } from '../i18n.js'
import {
  setupCode,
  titleCode,
  routeCode,
  navApiCode,
  linksCode,
  queryCode,
  guardCode,
  warmOnHoverCode,
  shellCode,
  useCasesCode,
} from '../snippets/navigation.js'


const guardSearch = route.search('guard')
const visitedSearch = route.search('visited')
const qSearch = route.search('q')
const slugParam = route.param('slug')

const pathLabel = derive(() => route.path())
const guardLabel = derive(() => guardSearch() ?? '—')
const visitedLabel = derive(() => visitedSearch() ?? '—')
const qLabel = derive(() => qSearch() ?? '—')
const slugLabel = derive(() => slugParam() ?? '—')
const hashLabel = derive(() => {
  const hash = nav.where().hash
  return hash ? hash : '—'
})
const paramsJson = derive(() => JSON.stringify(nav.where().params))
const searchJson = derive(() => JSON.stringify(nav.where().search))

const lastAction = pulse(translate('nav.live.ready'))
const lastActionLabel = derive(() => translate('nav.live.lastAction', { action: lastAction() }))
const draftQuery = pulse(qSearch() ?? '')
const filteringLabel = derive(() => translate('nav.demo.query.filtering', { q: qSearch() ?? '' }))

function mark(action) {
  lastAction.set(action)
}

function simulate(path, label) {
  mark(label ?? `nav.go(${path})`)
  nav.go(path)
}

function goHelpers() {
  mark('nav.go(/nav?visited=1)')
  nav.go('/nav?visited=1')
}

function goFocus() {
  mark('nav.go(/nav, { focus: true })')
  nav.go('/nav', { focus: true })
}

function swapHelpers() {
  mark('nav.swap(/nav?visited=swap)')
  nav.swap('/nav?visited=swap')
}

function undoHelpers() {
  mark('nav.undo()')
  nav.undo()
}

function warmForms() {
  mark("nav.warm('/forms')")
  nav.warm('/forms')
}

const topics = [
  { slug: 'alpha', label: 'alpha' },
  { slug: 'beta', label: 'beta' },
  { slug: 'gamma', label: 'gamma' },
]

function topicHref(slug) {
  return routeHref('/topic/:slug', { slug })
}

function applyQuery() {
  const value = draftQuery().trim()
  const next = value ? `/nav?q=${encodeURIComponent(value)}` : '/nav'
  mark(`nav.go(${next})`)
  nav.go(next)
}

function clearQuery() {
  draftQuery.set('')
  mark('nav.swap(/nav)')
  nav.swap('/nav')
}

function armGuard() {
  sessionStorage.setItem('jacare-lab:guard', '1')
  mark("guard armed → nav.go('/nav')")
  nav.go('/nav')
}

const prefetchTargets = [
  { path: '/css', labelKey: 'lesson.css.title' },
  { path: '/forms', labelKey: 'lesson.forms.title' },
  { path: '/playground', labelKey: 'lesson.playground.title' },
]
const warmed = pulse([])
const warmedLabel = derive(() =>
  warmed().length > 0 ? warmed().join(', ') : translate('nav.demo.prefetch.none'),
)
const warmedSummary = derive(() => translate('nav.demo.prefetch.warmed', { list: warmedLabel() }))

function warmOnHover(path) {
  nav.warm(path)
  if (!warmed().includes(path)) warmed.update((list) => [...list, path])
}

const createNavOptions = [
  { name: 'layout', detailKey: 'nav.options.layout' },
  { name: 'screens', detailKey: 'nav.options.screens' },
  { name: 'missing', detailKey: 'nav.options.missing' },
  { name: 'base', detailKey: 'nav.options.base' },
  { name: 'beforeGo', detailKey: 'nav.options.beforeGo' },
]

const useCases = [
  { nameKey: 'nav.useCases.shellName', detailKey: 'nav.useCases.shellDetail' },
  { nameKey: 'nav.useCases.entityName', detailKey: 'nav.useCases.entityDetail' },
  { nameKey: 'nav.useCases.filtersName', detailKey: 'nav.useCases.filtersDetail' },
  { nameKey: 'nav.useCases.authName', detailKey: 'nav.useCases.authDetail' },
  { nameKey: 'nav.useCases.prefetchName', detailKey: 'nav.useCases.prefetchDetail' },
  { nameKey: 'nav.useCases.subpathName', detailKey: 'nav.useCases.subpathDetail' },
  { nameKey: 'nav.useCases.titleName', detailKey: 'nav.useCases.titleDetail' },
]

const navMethods = [
  { name: 'attach(target)', detailKey: 'nav.methods.attach' },
  { name: 'go(path)', detailKey: 'nav.methods.go' },
  { name: 'swap(path)', detailKey: 'nav.methods.swap' },
  { name: 'undo()', detailKey: 'nav.methods.undo' },
  { name: 'warm(path)', detailKey: 'nav.methods.warm' },
  { name: 'where', detailKey: 'nav.methods.where' },
]

const templateAttrs = [
  { name: 'jacare-frame', detailKey: 'nav.attrs.frame' },
  { name: 'jacare-go', detailKey: 'nav.attrs.go' },
  { name: 'jacare-here', detailKey: 'nav.attrs.here' },
]

export <view>
  <section class="page page-nav">
    <header class="page-hero">
      <p class="page-kicker">${t('nav.kicker')}</p>
      <h1 class="page-title">${t('nav.title')}</h1>
      <p class="page-lead">${t('nav.lead')}</p>
    </header>

    <Tip :text=${t('nav.tip')} />

    <article class="nav-setup">
      <header class="nav-setup-head">
        <div>
          <Badge :text=${t('nav.setup.badge')} />
          <h2 class="nav-setup-title">${t('nav.setup.title')}</h2>
          <p class="nav-setup-lead">${t('nav.setup.lead')}</p>
        </div>
        <button type="button" class="btn btn-ghost" on-click=${() => showCode(translate('nav.setup.codeTitle'), setupCode)}>${t('shell.viewCode')}</button>
      </header>

      <ol class="nav-flow">
        <li><strong>createNav</strong> — ${t('nav.setup.flowCreateNav')}</li>
        <li><strong>createRoute(nav.where)</strong> — ${t('nav.setup.flowCreateRoute')}</li>
        <li><strong>nav.attach(#app)</strong> — ${t('nav.setup.flowAttach')}</li>
        <li><strong>${t('nav.setup.navigateName')}</strong> — ${t('nav.setup.flowNavigate')}</li>
      </ol>

      <div class="nav-options-grid">
        <section class="nav-options-card">
          <h3 class="nav-options-title">${t('nav.setup.optionsTitle')}</h3>
          <div class="nav-live">
            #for createNavOptions as option (option.name)
              <div class="nav-live-row">
                <span>${option.name}</span>
                <code>${t(option.detailKey)}</code>
              </div>
            #end
          </div>
        </section>

        <section class="nav-options-card">
          <h3 class="nav-options-title">${t('nav.setup.methodsTitle')}</h3>
          <div class="nav-live">
            #for navMethods as method (method.name)
              <div class="nav-live-row">
                <span>${method.name}</span>
                <code>${t(method.detailKey)}</code>
              </div>
            #end
          </div>
        </section>

        <section class="nav-options-card">
          <h3 class="nav-options-title">${t('nav.setup.attrsTitle')}</h3>
          <div class="nav-live">
            #for templateAttrs as attr (attr.name)
              <div class="nav-live-row">
                <span>${attr.name}</span>
                <code>${t(attr.detailKey)}</code>
              </div>
            #end
          </div>
        </section>
      </div>
    </article>

    <article class="nav-setup">
      <header class="nav-setup-head">
        <div>
          <Badge :text=${t('nav.useCases.badge')} />
          <h2 class="nav-setup-title">${t('nav.useCases.title')}</h2>
          <p class="nav-setup-lead">${t('nav.useCases.lead')}</p>
        </div>
        <button type="button" class="btn btn-ghost" on-click=${() => showCode(translate('nav.useCases.codeTitle'), useCasesCode)}>${t('shell.viewCode')}</button>
      </header>
      <div class="nav-live">
        #for useCases as item (item.nameKey)
          <div class="nav-live-row">
            <span>${t(item.nameKey)}</span>
            <code>${t(item.detailKey)}</code>
          </div>
        #end
      </div>
    </article>

    <div class="nav-summary">
      <Badge :text=${t('nav.live.badge')} />
      <div class="nav-live">
        <div class="nav-live-row"><span>path</span><code>${pathLabel}</code></div>
        <div class="nav-live-row"><span>?visited</span><code>${visitedLabel}</code></div>
        <div class="nav-live-row"><span>?q</span><code>${qLabel}</code></div>
        <div class="nav-live-row"><span>?guard</span><code>${guardLabel}</code></div>
        <div class="nav-live-row"><span>params.slug</span><code>${slugLabel}</code></div>
        <div class="nav-live-row"><span>hash</span><code>${hashLabel}</code></div>
        <div class="nav-live-row"><span>params</span><code>${paramsJson}</code></div>
        <div class="nav-live-row"><span>search</span><code>${searchJson}</code></div>
      </div>
      <p class="muted">${lastActionLabel}</p>
    </div>

    <div class="lesson-grid">
      <Demo :title=${t('nav.demo.title.title')} :lead=${t('nav.demo.title.lead')} :code=${titleCode}>
        <p class="muted">${t('nav.demo.title.noteA')} <code>title</code> ${t('nav.demo.title.noteB')} <code>nav.js</code>. ${t('nav.demo.title.noteC')} <code>params.slug</code>.</p>
      </Demo>

      <Demo :title=${t('nav.demo.routes.title')} :lead=${t('nav.demo.routes.lead')} :code=${routeCode}>
        <div class="stack">
          <div class="nav-live">
            <div class="nav-live-row"><span>path</span><code>${pathLabel}</code></div>
            <div class="nav-live-row"><span>?visited</span><code>${visitedLabel}</code></div>
            <div class="nav-live-row"><span>?q</span><code>${qLabel}</code></div>
            <div class="nav-live-row"><span>?guard</span><code>${guardLabel}</code></div>
            <div class="nav-live-row"><span>params.slug</span><code>${slugLabel}</code></div>
            <div class="nav-live-row"><span>hash</span><code>${hashLabel}</code></div>
            <div class="nav-live-row"><span>params</span><code>${paramsJson}</code></div>
            <div class="nav-live-row"><span>search</span><code>${searchJson}</code></div>
          </div>

          <div class="nav-sim">
            <div class="nav-sim-group">
              <span class="nav-sim-label">path</span>
              <div class="row">
                <button type="button" class="btn btn-outline" on-click=${() => simulate('/nav', 'path → /nav')}>/nav</button>
                <button type="button" class="btn btn-outline" on-click=${() => simulate('/forms', 'path → /forms')}>/forms</button>
                <button type="button" class="btn btn-outline" on-click=${() => simulate('/reactivity', 'path → /reactivity')}>/reactivity</button>
              </div>
            </div>

            <div class="nav-sim-group">
              <span class="nav-sim-label">?visited</span>
              <div class="row">
                <button type="button" class="btn btn-outline" on-click=${() => simulate('/nav?visited=1', '?visited=1')}>visited=1</button>
                <button type="button" class="btn btn-outline" on-click=${() => simulate('/nav?visited=swap', '?visited=swap')}>visited=swap</button>
                <button type="button" class="btn btn-ghost" on-click=${() => simulate('/nav', 'clear ?visited')}>${t('nav.demo.routes.clear')}</button>
              </div>
            </div>

            <div class="nav-sim-group">
              <span class="nav-sim-label">?q</span>
              <div class="row">
                <button type="button" class="btn btn-outline" on-click=${() => simulate('/nav?q=jacare', '?q=jacare')}>q=jacare</button>
                <button type="button" class="btn btn-outline" on-click=${() => simulate('/nav?q=lab', '?q=lab')}>q=lab</button>
                <button type="button" class="btn btn-ghost" on-click=${() => simulate('/nav', 'clear ?q')}>${t('nav.demo.routes.clear')}</button>
              </div>
            </div>

            <div class="nav-sim-group">
              <span class="nav-sim-label">?guard</span>
              <div class="row">
                <button type="button" class="btn btn-outline" on-click=${armGuard}>${t('nav.demo.routes.armGo')}</button>
                <button type="button" class="btn btn-outline" on-click=${() => simulate('/nav?guard=blocked', '?guard=blocked')}>guard=blocked</button>
                <button type="button" class="btn btn-ghost" on-click=${() => simulate('/nav', 'clear ?guard')}>${t('nav.demo.routes.clear')}</button>
              </div>
            </div>

            <div class="nav-sim-group">
              <span class="nav-sim-label">params.slug</span>
              <div class="row">
                #for topics as topic (topic.slug)
                  <button
                    type="button"
                    class="btn btn-outline"
                    on-click=${() => simulate(topicHref(topic.slug), `params.slug=${topic.slug}`)}
                  >
                    ${topic.label}
                  </button>
                #end
                <button type="button" class="btn btn-ghost" on-click=${() => simulate('/nav', 'clear params.slug')}>${t('nav.demo.routes.backToNav')}</button>
              </div>
            </div>

            <div class="nav-sim-group">
              <span class="nav-sim-label">hash</span>
              <div class="row">
                <button type="button" class="btn btn-outline" on-click=${() => simulate('/nav#demo', 'hash → #demo')}>#demo</button>
                <button type="button" class="btn btn-outline" on-click=${() => simulate('/nav#live', 'hash → #live')}>#live</button>
                <button type="button" class="btn btn-ghost" on-click=${() => simulate('/nav', 'clear hash')}>${t('nav.demo.routes.clear')}</button>
              </div>
            </div>

            <div class="nav-sim-group">
              <span class="nav-sim-label">${t('nav.demo.routes.combined')}</span>
              <div class="row">
                <button type="button" class="btn" on-click=${() => simulate('/nav?visited=1&q=jacare#demo', 'visited + q + hash')}>visited + q + hash</button>
                <button type="button" class="btn btn-outline" on-click=${() => simulate('/topic/beta?q=lab#focus', 'slug + q + hash')}>slug + q + hash</button>
                <button type="button" class="btn btn-ghost" on-click=${() => simulate('/nav', 'reset all')}>${t('nav.demo.routes.resetAll')}</button>
              </div>
            </div>
          </div>
        </div>
      </Demo>

      <Demo :title=${t('nav.demo.api.title')} :lead=${t('nav.demo.api.lead')} :code=${navApiCode}>
        <div class="stack">
          <h2 data-jacare-focus tabindex="-1" class="page-title" style="font-size:1.1rem;margin:0">${t('nav.demo.api.focusTarget')}</h2>
          <div class="row">
            <button type="button" class="btn" on-click=${goHelpers}>nav.go</button>
            <button type="button" class="btn btn-outline" on-click=${goFocus}>${t('nav.demo.api.goFocus')}</button>
            <button type="button" class="btn btn-outline" on-click=${swapHelpers}>nav.swap</button>
            <button type="button" class="btn btn-outline" on-click=${undoHelpers}>nav.undo</button>
            <button type="button" class="btn btn-ghost" on-click=${warmForms}>nav.warm('/forms')</button>
          </div>
          <p class="muted">${t('nav.demo.api.note')}</p>
        </div>
      </Demo>

      <Demo :title=${t('nav.demo.query.title')} :lead=${t('nav.demo.query.lead')} :code=${queryCode}>
        <div class="stack">
          <div class="row">
            <input class="input" bind-value=${draftQuery} placeholder=${t('nav.demo.query.placeholder')} />
            <button type="button" class="btn" on-click=${applyQuery}>${t('nav.demo.query.apply')}</button>
            <button type="button" class="btn btn-outline" on-click=${clearQuery}>${t('nav.demo.query.clear')}</button>
          </div>
          #if qSearch()
            <p class="muted">${filteringLabel}</p>
          #else
            <p class="muted">${t('nav.demo.query.empty')}</p>
          #end
        </div>
      </Demo>

      <Demo :title=${t('nav.demo.links.title')} :lead=${t('nav.demo.links.lead')} :code=${linksCode}>
        <div class="stack">
          <div class="row">
            #for topics as topic (topic.slug)
              <a
                class="btn btn-outline"
                jacare-go=${topicHref(topic.slug)}
                href=${appHref(topicHref(topic.slug))}
              >
                ${t('nav.demo.links.topicLabel')} ${topic.label}
              </a>
            #end
          </div>
          <p class="muted">${t('nav.demo.links.note')}</p>
        </div>
      </Demo>

      <Demo :title=${t('nav.demo.guard.title')} :lead=${t('nav.demo.guard.lead')} :code=${guardCode}>
        <div class="stack">
          <button type="button" class="btn" on-click=${armGuard}>${t('nav.demo.guard.arm')}</button>
          #if guardSearch() === 'blocked'
            <p class="nav-alert">${t('nav.demo.guard.fired')}</p>
          #else
            <p class="muted">${t('nav.demo.guard.hint')}</p>
          #end
        </div>
      </Demo>

      <Demo :title=${t('nav.demo.prefetch.title')} :lead=${t('nav.demo.prefetch.lead')} :code=${warmOnHoverCode}>
        <div class="stack">
          <div class="row">
            #for prefetchTargets as item (item.path)
              <a
                class="btn btn-outline"
                jacare-go=${item.path}
                href=${appHref(item.path)}
                on-pointerenter=${() => warmOnHover(item.path)}
              >
                ${t(item.labelKey)}
              </a>
            #end
          </div>
          <p class="muted">${warmedSummary}</p>
        </div>
      </Demo>

      <Demo :title=${t('nav.demo.shell.title')} :lead=${t('nav.demo.shell.lead')} :code=${shellCode}>
        <div class="stack">
          <p class="muted">${t('nav.demo.shell.note')}</p>
          <a class="btn btn-outline" jacare-go="/playground" href=${appHref('/playground')}>${t('nav.demo.shell.open')}</a>
        </div>
      </Demo>
    </div>
  </section>
</view>
