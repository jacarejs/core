import { pulse, derive } from '@jacare/core'
import { appHref } from '../app-base.js'
import { t, translate } from '../i18n.js'
import Tip from '../components/Tip.jcr'
import { IMPORT_CATALOG } from '../imports-catalog.js'

const query = pulse('')
const pkgFilter = pulse('all')

const packages = ['all', ...new Set(IMPORT_CATALOG.map((row) => row.pkg))]

function catalogUsage(row) {
  return translate(`helpersCatalog.${row.id}.usage`)
}

function catalogAbout(row) {
  return translate(`helpersCatalog.${row.id}.about`)
}

function catalogGroup(row) {
  return translate(`helpersCatalog.groups.${row.groupId}`)
}

const visibleRows = derive(() => {
  const q = query().trim().toLowerCase()
  const pkg = pkgFilter()
  return IMPORT_CATALOG.filter((row) => {
    if (pkg !== 'all' && row.pkg !== pkg) return false
    if (!q) return true
    const hay = `${row.name} ${catalogGroup(row)} ${row.pkg} ${catalogUsage(row)} ${catalogAbout(row)} ${row.importLine} ${row.example}`.toLowerCase()
    return hay.includes(q)
  })
})

function setPkg(name) {
  pkgFilter.set(name)
}

function pkgLabel(name) {
  return name === 'all' ? translate('helpersPage.filterAll') : name
}

const countLabel = derive(
  () =>
    `${visibleRows().length} ${translate('helpersPage.countOf')} ${IMPORT_CATALOG.length} ${translate('helpersPage.countSymbols')}`,
)

export <view>
  <section class="page">
    <header class="page-hero">
      <p class="page-kicker">${t('helpersPage.kicker')}</p>
      <h1 class="page-title">${t('helpersPage.title')}</h1>
      <p class="page-lead">
        ${t('helpersPage.lead1')}
        <code>docs/api.md</code>
        ${t('helpersPage.lead2')}
      </p>
    </header>

    <Tip :text=${translate('helpersPage.tip')} />

    <div class="stack" style="gap:0.75rem">
      <input class="input" bind-value=${query} placeholder=${translate('helpersPage.filterPlaceholder')} />
      <div class="row" style="flex-wrap:wrap;gap:0.4rem">
        #for packages as pkg (pkg)
          <button
            type="button"
            class="btn btn-outline"
            class-active=${pkgFilter() === pkg}
            on-click=${() => setPkg(pkg)}
          >${pkgLabel(pkg)}</button>
        #end
      </div>
      <p class="muted">${countLabel}</p>
    </div>

    <div class="helper-table import-catalog">
      #for visibleRows() as row (row.name + row.pkg)
        <article class="helper-row import-row">
          <div class="import-row-head">
            <code class="import-name">${row.name}</code>
            <span class="badge">${catalogGroup(row)}</span>
            <span class="badge badge-warn">${row.pkg}</span>
          </div>
          <p class="import-usage">${catalogUsage(row)}</p>
          <p class="import-about">${catalogAbout(row)}</p>
          <p class="import-label muted">${t('helpersPage.importLabel')}</p>
          <pre class="import-line"><code>${row.importLine}</code></pre>
          <p class="import-label muted">${t('helpersPage.exampleLabel')}</p>
          <pre class="import-example"><code>${row.example}</code></pre>
          <a class="btn btn-outline" jacare-go=${row.path} href=${appHref(row.path)}>${t('helpersPage.openLesson')}</a>
        </article>
      #end
      #if visibleRows().length === 0
        <p class="muted">${t('helpersPage.empty')}</p>
      #end
    </div>
  </section>
</view>
