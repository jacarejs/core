import { pulse, derive } from '@jacare/core'
import Tip from '../components/Tip.jcr'
import Demo from '../components/Demo.jcr'
import { appHref } from '../app-base.js'
import { t } from '../i18n.js'
import {
  singleCode,
  labelCopyCode,
  shorthandCode,
  nestedCode,
  syntaxCard,
} from '../snippets/debug.js'

const cart = pulse([
  { id: 'a', qty: 1 },
  { id: 'b', qty: 2 },
])

function addItem() {
  cart.update((items) => [
    ...items,
    { id: String.fromCharCode(97 + items.length), qty: 1 },
  ])
}

function bumpQty() {
  cart.update((items) =>
    items.map((item, i) => (i === 0 ? { ...item, qty: item.qty + 1 } : item)),
  )
}

const score = pulse(0)
const mood = pulse('curious')
const removed = pulse(0)

function bumpScore() {
  score.update((n) => n + 1)
}

function cycleMood() {
  const next = { curious: 'focused', focused: 'done', done: 'curious' }
  mood.update((m) => next[m] ?? 'curious')
}

function bumpRemoved() {
  removed.update((n) => n + 1)
}

const user = pulse({ name: 'Ada', role: 'admin' })
const flags = pulse({ dark: true, beta: false })
const summary = derive(() => ({
  user: user(),
  flags: flags(),
}))

function toggleDark() {
  flags.update((f) => ({ ...f, dark: !f.dark }))
}

function renameUser() {
  user.update((u) => ({
    ...u,
    name: u.name === 'Ada' ? 'Grace' : 'Ada',
  }))
}

export <view>
  <section class="page">
    <header class="page-hero">
      <p class="page-kicker">${t('debug.kicker')}</p>
      <h1 class="page-title">${t('debug.title')}</h1>
      <p class="page-lead">${t('debug.lead')}</p>
    </header>

    <Tip :text=${t('debug.tip')} />

    <div class="ref-card">
      <h3>${t('debug.syntax.title')}</h3>
      <p class="muted">${t('debug.syntax.body')}</p>
      <pre><code>${syntaxCard}</code></pre>
      <p class="muted">
        ${t('debug.syntax.alsoUsedIn')}
        <a class="text-link" jacare-go="/components" href=${appHref('/components')}>${t('lesson.components.title')}</a>
        ${t('debug.syntax.and')}
        <a class="text-link" jacare-go="/events" href=${appHref('/events')}>${t('lesson.events.title')}</a>.
      </p>
    </div>

    <div class="lesson-grid">
      <Demo :title=${t('debug.demo.single.title')} :lead=${t('debug.demo.single.lead')} :code=${singleCode}>
        <div class="stack">
          <div class="row">
            <button type="button" class="btn" on-click=${addItem}>${t('debug.demo.single.add')}</button>
            <button type="button" class="btn btn-outline" on-click=${bumpQty}>${t('debug.demo.single.bump')}</button>
          </div>
          <debug>${cart}</debug>
        </div>
      </Demo>

      <Demo :title=${t('debug.demo.labelCopy.title')} :lead=${t('debug.demo.labelCopy.lead')} :code=${labelCopyCode}>
        <div class="stack">
          <p class="muted">${t('debug.demo.labelCopy.note')}</p>
          <debug copy label="cart">${cart}</debug>
        </div>
      </Demo>

      <Demo :title=${t('debug.demo.shorthand.title')} :lead=${t('debug.demo.shorthand.lead')} :code=${shorthandCode}>
        <div class="stack">
          <div class="row">
            <button type="button" class="btn" on-click=${bumpScore}>score++</button>
            <button type="button" class="btn btn-outline" on-click=${cycleMood}>${t('debug.demo.shorthand.cycleMood')}</button>
            <button type="button" class="btn btn-outline" on-click=${bumpRemoved}>removed++</button>
          </div>
          <debug copy label="props">${{ score, mood, removed }}</debug>
        </div>
      </Demo>

      <Demo :title=${t('debug.demo.nested.title')} :lead=${t('debug.demo.nested.lead')} :code=${nestedCode}>
        <div class="stack">
          <div class="row">
            <button type="button" class="btn" on-click=${renameUser}>${t('debug.demo.nested.rename')}</button>
            <button type="button" class="btn btn-outline" on-click=${toggleDark}>${t('debug.demo.nested.toggleDark')}</button>
          </div>
          <debug copy label="summary">${summary}</debug>
        </div>
      </Demo>
    </div>
  </section>
</view>
