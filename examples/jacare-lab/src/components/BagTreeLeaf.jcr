import { treeCart } from '../bags/cart.js'
import { t } from '../i18n.js'
import BagDepth from './BagDepth.jcr'

const SAMPLE = { id: 'depth', name: 'Depth kit', price: 15 }

export <view>
  <BagDepth :label=${t('bagTree.leafLabel')}>
    <p class="muted">${t('bagTree.leafNote')}</p>
    <div class="row">
      <button type="button" class="btn" on-click=${() => treeCart.add(SAMPLE)}>
        ${t('bagTree.leafAdd')}
      </button>
      <span class="muted">${t('bagTree.leafCount')} ${treeCart.count}</span>
    </div>
  </BagDepth>
</view>
